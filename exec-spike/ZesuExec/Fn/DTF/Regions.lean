import ZesuExec.Fn.DTF.Spec
import ZesuExec.Fn.Common

/-!
# DTF regions, cut points and their shapes (programme plan S7 step 3)

Cut points (162): the map's 153 (entry, 50 loop heads, 87 call return sites, 15 join cuts), the
five jump-table targets (`0x80000588` legacy, `0x8000081c` EIP-2930, `0x8000069c` EIP-1559,
`0x8000075c` EIP-4844, `0x800005dc` EIP-7702) and three hand-placed cuts:

* `0x80000574`, the jump-table load: `a0` is the table word `0x80110050 + 8 (tx_type & 0xff)`,
  made region 4 (8 rodata bytes), so the `ld` is a constant-offset read and the `jr` a `.jumpInd`
  leaf whose target is that word (the executor reads rodata only at literal addresses);
* `0x80002138`, the store of a versioned hash into the `txHashList` buffer (`a0` = slot `len`,
  region 4, 32 bytes);
* `0x80002434`, the store of an `AuthorizationTuple` into the `txAuthList` buffer (`a0` = slot
  `len`, region 4, 0x90 bytes).

The executor stores only at constant offsets of a region, so the two buffer stores need the slot
as a region (as TX's `0x80000230`/`0x80000460`).

Regions, the same indices at every cut:

| index | region | size | base |
|---|---|---|---|
| 0 | frame `[S-0x370, S)` | 0x370 | `sp` at entry minus 0x370 |
| 1 | result | 0x128 | `a0` at entry |
| 2 | allocator object | 16 | `a1` at entry |
| 3 | payload | unknown (obligations) | `a3` at entry |
| 4 | slot (the three hand-placed cuts) | 8 / 32 / 0x90 | `a0` at the cut |

Per cut point the table `table` (generated by `OPEN/DTF/shape.py`, a forward analysis of the
instructions) gives:

* `shape`: the registers and 8-byte frame slots that are not plain variables: frame, result and
  allocator pointers, the vtable word, pointers into the payload. A payload pointer in register
  `i` is `ptr 3 0 + var (32 + i)`, in the frame slot at offset `o` it is
  `ptr 3 0 + var (64 + o / 8)`; the cut's `Env` sets those variables to the pointer minus the
  payload base, so they carry no assertion content.
* `arms`: the jump-table arms (`tx_type`) that reach it.
* `rest`: where the `rest` slice `{ptr, len}` after the first `k` top-level items is held
  (registers or frame slots); the assertion relates it to the payload.
* `plain`/`site`: a call return site has the call's `site` (callee, the shape, arms and `rest`
  at the call instruction); `plain` is false when the only way in is the return.
-/

namespace ZesuExec.Fn.DTF
open ZesuExec ZesuExec.Sym

def frameBytes : Nat := 0x370

def frameR : Region := ⟨some frameBytes, 16, true⟩
def resR : Region := ⟨some resultBytes, 1, true⟩
def aoR : Region := ⟨some 16, 1, false⟩
def inR : Region := ⟨none, 1, false⟩

def baseRegions : List Region := [frameR, resR, aoR, inR]

/-- The allocator object's vtable word. -/
def vtableKnown : Write := ⟨2, 8, 8, .lit TX.vtable⟩

/-- What a register or a frame slot holds at a cut. -/
inductive Val
  /-- the frame base plus `k` (the entry `sp` is `fr 0x370`) -/
  | fr (k : Nat)
  | res (k : Nat)
  | ao (k : Nat)
  /-- `alt_fl_alloc.vtable` -/
  | vt
  /-- a pointer into the payload -/
  | inp
  /-- the base of region 4 -/
  | slot
  deriving DecidableEq, Repr, Inhabited

def regVar (i : Nat) : Nat := 32 + i
def slotVar (o : Nat) : Nat := 64 + o / 8

def Val.sym (fresh : Nat) : Val → Sym
  | .fr k => .ptr 0 k
  | .res k => .ptr 1 k
  | .ao k => .ptr 2 k
  | .vt => .lit TX.vtable
  | .inp => .bin .add (.ptr 3 0) (.var fresh)
  | .slot => .ptr 4 0

/-- Registers and frame slots (offset from the frame base) that are not plain variables, and the
extra region of a hand-placed cut. -/
structure Shape where
  regs : List (Nat × Val)
  slots : List (Nat × Val)
  extra : List Region
  deriving Inhabited

def Shape.ov (sh : Shape) (i : Nat) : Option Sym := (sh.regs.lookup i).map (Val.sym (regVar i))

def Shape.known (sh : Shape) : List Write :=
  vtableKnown :: sh.slots.map fun (o, v) => ⟨0, o, 8, v.sym (slotVar o)⟩

def Shape.S (sh : Shape) : SState := entryState sh.ov (baseRegions ++ sh.extra) sh.known

/-- A register or an 8-byte frame slot (offset from the frame base). -/
inductive Loc
  | reg (i : Nat)
  | slot (o : Nat)
  deriving DecidableEq, Repr, Inhabited

/-- `loc` holds the pointer (`len = false`) or the length (`len = true`) of the `rest` slice
after the first `k` top-level items. -/
structure RestLoc where
  loc : Loc
  len : Bool
  k : Nat
  deriving DecidableEq, Repr, Inhabited

/-- The callee of a call return site (the allocator's by vtable slot). -/
inductive Kind | f2 | f1 | f4 | memcpy | tx | alloc | remap | free
  deriving DecidableEq, Repr, Inhabited

structure Site where
  kind : Kind
  shape : Shape
  arms : List Nat
  rest : List RestLoc
  deriving Inhabited

structure CutData where
  pc : Nat
  shape : Shape
  arms : List Nat
  rest : List RestLoc
  plain : Bool
  site : Option Site
  deriving Inhabited

