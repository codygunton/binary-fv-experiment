+/-- The copy contract's own `stepBound`, read off the real `FunctionContract` records. Unlike the
+read family's, this one **does** depend on its arguments (`64 + 8 * length` / `64 + 16 * length`), so
+a row whose `length` is not reconstructible gets no bound and an explicit gap. -/
+def copyStepBound (family : CopyFamily) (args : CopyArgs) : Nat :=
+  match family with
+  | .memcpy => (contractMemcpy canonicalEnvironment).stepBound args
+  | .memmove => (contractMemmove canonicalEnvironment).stepBound args
+
+/-- The copy contract's meaning at the reconstructed args, taken from the real contract. -/
+def copyMeaning (family : CopyFamily) (args : CopyArgs) : Except SszDecodeError ByteArray :=
+  match family with
+  | .memcpy => (contractMemcpy canonicalEnvironment).meaning args
+  | .memmove => (contractMemmove canonicalEnvironment).meaning args
