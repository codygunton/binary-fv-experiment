+    {result : Except SszDecodeError (Option UInt64)} {before after : State}
+    (h : postOptionalU64 canonicalEnvironment args result before after) :
+    postOptionalU64CheckedB canonicalEnvironment args before after = true := by
+  obtain ⟨hmem, hcode, hnoalloc, _, _⟩ := h
+  simp only [postOptionalU64CheckedB, preservedInputAndCodeB, Bool.and_eq_true]
+  exact ⟨⟨memoryBytesB_of_memoryBytes hmem, codeIntactB_of_fileBytesMatchMemory hcode⟩,
