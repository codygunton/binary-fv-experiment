+/-! ## The four decoder families, mirrored
+
+`zesuDecodeRaw` (index 1), `decodeRaw` (6), `optionalU64` (124) and `byteListList` (126) are
+**emitted** function instances: each is a real call boundary with its own prologue, so the RV64 LP64
+calling convention genuinely applies and a register-shaped precondition is a meaningful question
+about them. On the 127 *inlined* instances it is a category error — the compiler put values wherever
+it liked — which is why the read family's `x12` refutations all land there and none lands here.
+
+Their four preconditions are the same shape as `preReadAt`: `MemoryBytes ∧ CodeIntact` plus one
+register equation per argument. Their postconditions are **not** one shape, and the difference is
+what decides how much of each is checkable:
+
+| routine | `post` | evaluated here | not evaluated |
+| --- | --- | --- | --- |
+| `zesuDecodeRaw` | `postZesuDecodeRaw` | input/code preservation, `x10 = returnCode`, the twelve `BitVec`-typed `platformPreserved` registers, `RetiredCounterPresent` | `DecoderGlobalsRep`; six non-`BitVec` `platformPreserved` registers |
+| `decodeRaw` | `postEntry` | input/code preservation | `WritesOnlyWithinOwnAllocation`, `repRawV4` at `resultBase` |
+| `optionalU64` | `postOptionalU64` | input/code preservation, `NoAllocation` | `WritesOnlyWithinOwnRecord`, the option layout at `resultBase` |
+| `byteListList` | `postCollection` | input/code preservation | `WritesOnlyWithinOwnAllocation`, the descriptor/array at `resultBase` |
+
+The two ownership clauses are *separately* settled — positively, and record-independently — by
+`decoder_ownership_clauses_hold_at_every_record` far below. They stay outside the refuting mirrors
+because their transport runs the other way: `WritesOnlyWithin (stack ∪ record)` does **not** imply
+`WritesOnlyWithin stack`, so a Boolean `false` there would refute nothing. -/
+
+/-! ### `preZesuDecodeRaw` — four of five conjuncts -/
+
+/-- Four of `preZesuDecodeRaw`'s five conjuncts. `DecoderGlobalsRep` — the complete incoming
+decoder-globals object — is **not** evaluated, so a `none` from the namer below is a gap and never a
+pass. The mirror is universally quantified over the four parameters it does not pin (`globals`,
+`resultBuffer`, `rep`, `incoming`), which is exactly what makes it sound to run without them. -/
+def preZesuDecodeRawCheckedB (env : DecoderEnvironment) (args : ZesuDecodeRawArgs) (s : State) :
+    Bool :=
+  memoryBytesB s args.inputBase args.bytes &&
+    codeIntactB env.image s &&
+    (s.regs.get? x10 == some (BitVec.ofNat 64 args.inputBase)) &&
+    (s.regs.get? x11 == some (BitVec.ofNat 64 args.bytes.size))
+
+theorem preZesuDecodeRawCheckedB_of_preZesuDecodeRaw {env : DecoderEnvironment}
+    {globals : DecoderGlobalsLayout} {resultBuffer : Nat}
+    {rep : ContainerRepresentation SszBridge.RawV4} {incoming : DecoderGlobalsModel}
+    {args : ZesuDecodeRawArgs} {s : State}
+    (h : preZesuDecodeRaw env globals resultBuffer rep incoming args s) :
+    preZesuDecodeRawCheckedB env args s = true := by
+  obtain ⟨hmem, hcode, h10, h11, _⟩ := h
+  simp only [preZesuDecodeRawCheckedB, Bool.and_eq_true, beq_iff_eq]
+  exact ⟨⟨⟨memoryBytesB_of_memoryBytes hmem, codeIntactB_of_fileBytesMatchMemory hcode⟩, h10⟩, h11⟩
+
+def preZesuDecodeRawFailure? (env : DecoderEnvironment) (args : ZesuDecodeRawArgs) (s : State) :
+    Option String :=
+  if !memoryBytesB s args.inputBase args.bytes then some "preZesuDecodeRaw.MemoryBytes"
+  else if !codeIntactB env.image s then some "preZesuDecodeRaw.CodeIntact"
+  else if s.regs.get? x10 != some (BitVec.ofNat 64 args.inputBase) then
+    some "preZesuDecodeRaw.x10=inputBase"
+  else if s.regs.get? x11 != some (BitVec.ofNat 64 args.bytes.size) then
+    some "preZesuDecodeRaw.x11=bytes.size"
+  else none
+
+theorem preZesuDecodeRaw_failing_conjunct_agrees_with_mirror (env : DecoderEnvironment)
+    (args : ZesuDecodeRawArgs) (s : State) :
+    (preZesuDecodeRawFailure? env args s).isNone = preZesuDecodeRawCheckedB env args s := by
+  simp only [preZesuDecodeRawFailure?, preZesuDecodeRawCheckedB]
+  by_cases h1 : memoryBytesB s args.inputBase args.bytes <;>
+    by_cases h2 : codeIntactB env.image s <;>
+    by_cases h3 : s.regs.get? x10 = some (BitVec.ofNat 64 args.inputBase) <;>
+    by_cases h4 : s.regs.get? x11 = some (BitVec.ofNat 64 args.bytes.size) <;> simp_all
+
+/-! ### `preEntry` and `preCollection` — the shared four-register ABI shape
+
+`decodeRaw` and `decodeByteListList` have *identical* preconditions up to the argument record:
+`(resultBase, allocatorBase, base, bytes.size)` in `x10`–`x13`. One mirror serves both, with the
+predicate name carried as a label so the reported conjunct still says which contract it came from. -/
+
+def preFourRegisterB (env : DecoderEnvironment) (base : Nat) (bytes : ByteArray)
+    (allocatorBase resultBase : Nat) (s : State) : Bool :=
+  memoryBytesB s base bytes &&
+    codeIntactB env.image s &&
+    (s.regs.get? x10 == some (BitVec.ofNat 64 resultBase)) &&
+    (s.regs.get? x11 == some (BitVec.ofNat 64 allocatorBase)) &&
+    (s.regs.get? x12 == some (BitVec.ofNat 64 base)) &&
+    (s.regs.get? x13 == some (BitVec.ofNat 64 bytes.size))
+
+theorem preFourRegisterB_of_preEntry {env : DecoderEnvironment} {args : EntryArgs} {s : State}
+    (h : preEntry env args s) :
+    preFourRegisterB env args.base args.bytes args.allocatorBase args.resultBase s = true := by
+  obtain ⟨hmem, hcode, h10, h11, h12, h13⟩ := h
+  simp only [preFourRegisterB, Bool.and_eq_true, beq_iff_eq]
+  exact ⟨⟨⟨⟨⟨memoryBytesB_of_memoryBytes hmem,
+    codeIntactB_of_fileBytesMatchMemory hcode⟩, h10⟩, h11⟩, h12⟩, h13⟩
+
+theorem preFourRegisterB_of_preCollection {env : DecoderEnvironment} {args : CollectionArgs}
+    {s : State} (h : preCollection env args s) :
+    preFourRegisterB env args.base args.bytes args.allocatorBase args.resultBase s = true := by
+  obtain ⟨hmem, hcode, h10, h11, h12, h13⟩ := h
+  simp only [preFourRegisterB, Bool.and_eq_true, beq_iff_eq]
+  exact ⟨⟨⟨⟨⟨memoryBytesB_of_memoryBytes hmem,
+    codeIntactB_of_fileBytesMatchMemory hcode⟩, h10⟩, h11⟩, h12⟩, h13⟩
+
+def preFourRegisterFailure? (label : String) (env : DecoderEnvironment) (base : Nat)
+    (bytes : ByteArray) (allocatorBase resultBase : Nat) (s : State) : Option String :=
+  if !memoryBytesB s base bytes then some (label ++ ".MemoryBytes")
+  else if !codeIntactB env.image s then some (label ++ ".CodeIntact")
+  else if s.regs.get? x10 != some (BitVec.ofNat 64 resultBase) then some (label ++ ".x10=resultBase")
+  else if s.regs.get? x11 != some (BitVec.ofNat 64 allocatorBase) then
+    some (label ++ ".x11=allocatorBase")
+  else if s.regs.get? x12 != some (BitVec.ofNat 64 base) then some (label ++ ".x12=base")
+  else if s.regs.get? x13 != some (BitVec.ofNat 64 bytes.size) then
+    some (label ++ ".x13=bytes.size")
+  else none
+
+theorem preFourRegister_failing_conjunct_agrees_with_mirror (label : String)
+    (env : DecoderEnvironment) (base : Nat) (bytes : ByteArray) (allocatorBase resultBase : Nat)
+    (s : State) :
+    (preFourRegisterFailure? label env base bytes allocatorBase resultBase s).isNone =
+      preFourRegisterB env base bytes allocatorBase resultBase s := by
+  simp only [preFourRegisterFailure?, preFourRegisterB]
+  by_cases h1 : memoryBytesB s base bytes <;>
+    by_cases h2 : codeIntactB env.image s <;>
+    by_cases h3 : s.regs.get? x10 = some (BitVec.ofNat 64 resultBase) <;>
+    by_cases h4 : s.regs.get? x11 = some (BitVec.ofNat 64 allocatorBase) <;>
+    by_cases h5 : s.regs.get? x12 = some (BitVec.ofNat 64 base) <;>
+    by_cases h6 : s.regs.get? x13 = some (BitVec.ofNat 64 bytes.size) <;> simp_all
