+/-! ### The ownership clauses, settled positively and record-independently
+
+`WritesOnlyWithinOwnRecord` and `WritesOnlyWithinOwnAllocation` both permit a region that contains
+the routine's result record. That containment runs the wrong way for a refuting mirror — a Boolean
+`false` at the *record-free* region refutes nothing, because the real record could have covered the
+offending address. It runs the *right* way for a positive: if every changed byte is already inside
+the record-free part, then the clause holds at **every** `recordBase`/`recordSize`, so the missing
+Row A binding stops mattering.
+
+That is the only direction claimed here, and it is why these live outside the mirrors above. -/
+
+theorem writesOnlyWithin_mono {owned wider : Region} {before after : State}
+    (hsub : ∀ address, owned address → wider address)
+    (h : WritesOnlyWithin owned before after) : WritesOnlyWithin wider before after :=
+  fun address hnot => h address (fun howned => hnot (hsub address howned))
+
+/-- **The record-free part of what an allocating decoder may write**: the arena interval its two
+cursor readings delimit, the allocator's own state, and the machine stack. -/
+def recordFreeAllocRegion (cursorBefore cursorAfter : Nat) : Region :=
+  Region.union (interval cursorBefore cursorAfter)
+    (Region.union canonicalEnvironment.allocatorState canonicalEnvironment.stack)
+
+def recordFreeAllocRegionB (cursorBefore cursorAfter address : Nat) : Bool :=
+  decide (cursorBefore ≤ address ∧ address < cursorAfter) ||
+    decide (Elfling.canonicalHeapPosAddr ≤ address ∧
+      address < Elfling.canonicalHeapPosAddr + 8) ||
+    decide (Elfling.canonicalHeapTopAddr ≤ address ∧
+      address < Elfling.canonicalHeapTopAddr + 8) ||
+    scalarReaderOwnedB address
+
+theorem recordFreeAllocRegionB_iff (cursorBefore cursorAfter : Nat) (address : Nat) :
+    recordFreeAllocRegionB cursorBefore cursorAfter address = true ↔
+      recordFreeAllocRegion cursorBefore cursorAfter address := by
+  simp [recordFreeAllocRegionB, recordFreeAllocRegion, Region.union, interval,
+    canonicalEnvironment, Elfling.canonicalAllocatorState, canonicalStack, range,
+    scalarReaderOwnedB, or_assoc]
+
+/-- Every address the record-free region permits is permitted by `ownedRegion` at **any** record. -/
+theorem recordFreeAllocRegion_le_ownedRegion (recordBase recordSize cursorBefore cursorAfter : Nat)
+    (address : Nat) (h : recordFreeAllocRegion cursorBefore cursorAfter address) :
+    canonicalEnvironment.ownedRegion recordBase recordSize cursorBefore cursorAfter address := by
+  rcases h with hint | hrest
+  · exact Or.inl (Or.inr hint)
+  · exact Or.inr hrest
+
+/-- **The allocating decoders' ownership clause, decided true at every result record.** The two
+cursor readings come from the machine, exactly as `WritesOnlyWithinOwnAllocation` reads them. -/
+theorem writesOnlyWithinOwnAllocation_of_recordFree {recordBase recordSize : Nat}
+    {cursorBefore cursorAfter : Nat} {before after : State}
+    (hbefore : canonicalEnvironment.cursor? before = some cursorBefore)
+    (hafter : canonicalEnvironment.cursor? after = some cursorAfter)
+    (h : writesOnlyWithinB (recordFreeAllocRegionB cursorBefore cursorAfter) before after = true) :
+    canonicalEnvironment.WritesOnlyWithinOwnAllocation recordBase recordSize before after :=
+  ⟨cursorBefore, cursorAfter, hbefore, hafter,
+    writesOnlyWithin_mono (recordFreeAllocRegion_le_ownedRegion recordBase recordSize _ _)
+      ((writesOnlyWithinB_iff (recordFreeAllocRegionB_iff cursorBefore cursorAfter)
+        before after).mp h)⟩
+
+/-- **The non-allocating decoder's ownership clause, decided true at every result record.** Writing
+only within the machine stack is stronger than writing only within `stack ∪ record`. -/
+theorem writesOnlyWithinOwnRecord_of_stackOnly {recordBase recordSize : Nat} {before after : State}
+    (h : scalarWritesOnlyWithinB before after = true) :
+    canonicalEnvironment.WritesOnlyWithinOwnRecord recordBase recordSize before after :=
+  writesOnlyWithin_mono
+    (fun address howned => by
+      rcases howned with hrec | hstack
+      · exfalso
+        rcases hrec with hrange | hint
+        · simp only [range] at hrange; omega
+        · simp only [interval] at hint; omega
+      · exact Or.inr hstack)
+    ((scalarWritesOnlyWithinB_iff before after).mp h)
+
+/-! ## The window a register-passed slice forces, and when it refutes `MemoryBytes`
+
+Every leaf precondition in this catalog pins `base` to `x10` and `bytes.size` to `x11` and *then*
+demands `MemoryBytes s base bytes`. Those three conjuncts together say something the harness can
+decide **without reconstructing the slice at all**: the argument bytes have to live at
+`[x10, x10 + x11)`. If the captured state holds no byte somewhere in that window, `MemoryBytes` is
+false at *every* `bytes`, so the precondition is unsatisfiable at that state — no witness
+construction, no Row A binding, and no choice of the unpinned arguments rescues it.
+
+This is the same universal-quantification move `leafFrameSharedB` makes for the unpinned result
+record, applied to the unpinned slice instead, and it is the one way a `pre` verdict here escapes the
+`@witness-args` caveat entirely. -/
+
+/-- Whether the captured state holds a byte at every address of `[base, base + size)`. -/
+def windowMappedB (s : State) (base size : Nat) : Bool :=
+  (List.range size).all fun k => (s.mem.get? (base + k)).isSome
+
+/-- **`MemoryBytes` implies the window is fully mapped**, so `windowMappedB = false` refutes
+`MemoryBytes` at every slice that covers the window. Read in the refuting direction, exactly like
+every other mirror here. -/
+theorem windowMappedB_of_memoryBytes {s : State} {base size : Nat} {bytes : ByteArray}
+    (hsize : size ≤ bytes.size) (h : MemoryBytes s base bytes) :
+    windowMappedB s base size = true := by
+  simp only [windowMappedB, List.all_eq_true, List.mem_range]
+  intro k hk
+  rw [h k (Nat.lt_of_lt_of_le hk hsize)]
+  rfl
+
+/-! ## `preCanonicalOffsets`, mirrored in full
+
+`requireCanonicalOffsets` is an **emitted** function — a real call boundary, where the RISC-V
+argument registers actually mean something. `preCanonicalOffsets` has the same five conjuncts as
+`preReadAt` with `fixedSize` where `preReadAt` has `offset`, and Row A binds `fixed_size` (and only
+`fixed_size`), so the `x12` clause is the one decidable independently of the two witness-constructed
+arguments. `offsets` appears in neither conjunct — see `preCanonicalOffsets_ignores_offsets` — so a
+verdict here is a verdict at *every* offset table. -/
+
+def preCanonicalOffsetsB (env : DecoderEnvironment) (args : CanonicalOffsetsArgs) (s : State) :
+    Bool :=
+  memoryBytesB s args.base args.bytes &&
+    codeIntactB env.image s &&
+    (s.regs.get? x10 == some (BitVec.ofNat 64 args.base)) &&
+    (s.regs.get? x11 == some (BitVec.ofNat 64 args.bytes.size)) &&
+    (s.regs.get? x12 == some (BitVec.ofNat 64 args.fixedSize))
+
+/-- **The mirror is implied by the predicate**, so `preCanonicalOffsetsB = false` refutes
+`preCanonicalOffsets`. -/
+theorem preCanonicalOffsetsB_of_preCanonicalOffsets {env : DecoderEnvironment}
+    {args : CanonicalOffsetsArgs} {s : State} (h : preCanonicalOffsets env args s) :
+    preCanonicalOffsetsB env args s = true := by
+  obtain ⟨hmem, hcode, h10, h11, h12⟩ := h
+  simp only [preCanonicalOffsetsB, Bool.and_eq_true, beq_iff_eq]
+  exact ⟨⟨⟨⟨memoryBytesB_of_memoryBytes hmem,
+    codeIntactB_of_fileBytesMatchMemory hcode⟩, h10⟩, h11⟩, h12⟩
+
+/-- **`preCanonicalOffsets` does not mention `offsets`.** The harness therefore reconstructs the
+argument record with an empty offset table and every `pre` verdict it prints is a verdict at every
+offset table — the one argument the artifact does not pin cannot change it. -/
+theorem preCanonicalOffsets_ignores_offsets (env : DecoderEnvironment)
+    (args : CanonicalOffsetsArgs) (offsets : List Nat) (s : State) :
+    preCanonicalOffsets env { args with offsets := offsets } s ↔ preCanonicalOffsets env args s :=
+  Iff.rfl
+
+/-- **The precondition is unsatisfiable at a state whose `[x10, x10 + x11)` window is not fully
+mapped.** `pre` forces `base = x10` and `bytes.size = x11`, so its `MemoryBytes` conjunct is about
+exactly that window; an absent byte there refutes it at every `bytes`, every `fixedSize` and every
+`offsets`. The `base < 2 ^ 64` side condition is what "`x10` pins `base`" actually gives — a register
+determines its value only modulo `2 ^ 64` — and it holds of every address a caller can pass. -/
+theorem preCanonicalOffsets_unsatisfiable_of_unmapped_window {env : DecoderEnvironment}
+    {s : State} {base size : Nat} (hbase64 : base < 2 ^ 64) (hsize64 : size < 2 ^ 64)
+    (hx10 : s.regs.get? x10 = some (BitVec.ofNat 64 base))
+    (hx11 : s.regs.get? x11 = some (BitVec.ofNat 64 size))
+    (hwindow : windowMappedB s base size = false) :
+    ∀ args : CanonicalOffsetsArgs, args.base < 2 ^ 64 → ¬ preCanonicalOffsets env args s := by
+  rintro args hargs64 ⟨hmem, -, h10, h11, -⟩
+  have hbase : args.base = base := by
+    have h : BitVec.ofNat 64 args.base = BitVec.ofNat 64 base := by
+      have := hx10.symm.trans h10
+      exact (Option.some.inj this).symm
+    have := congrArg BitVec.toNat h
+    simpa [BitVec.toNat_ofNat, Nat.mod_eq_of_lt hargs64, Nat.mod_eq_of_lt hbase64] using this
+  have hsize : size ≤ args.bytes.size := by
+    have h : BitVec.ofNat 64 args.bytes.size = BitVec.ofNat 64 size := by
+      have := hx11.symm.trans h11
+      exact (Option.some.inj this).symm
+    have h' := congrArg BitVec.toNat h
+    simp only [BitVec.toNat_ofNat, Nat.mod_eq_of_lt hsize64] at h'
+    calc size = args.bytes.size % 2 ^ 64 := h'.symm
+      _ ≤ args.bytes.size := Nat.mod_le _ _
+  subst hbase
+  rw [windowMappedB_of_memoryBytes hsize hmem] at hwindow
+  exact Bool.noConfusion hwindow
+
+/-- The first `preCanonicalOffsets` conjunct that fails, by name. -/
+def preCanonicalOffsetsFailure? (env : DecoderEnvironment) (args : CanonicalOffsetsArgs)
+    (s : State) : Option String :=
+  if !memoryBytesB s args.base args.bytes then some "preCanonicalOffsets.MemoryBytes"
+  else if !codeIntactB env.image s then some "preCanonicalOffsets.CodeIntact"
+  else if s.regs.get? x10 != some (BitVec.ofNat 64 args.base) then
+    some "preCanonicalOffsets.x10=base"
+  else if s.regs.get? x11 != some (BitVec.ofNat 64 args.bytes.size) then
+    some "preCanonicalOffsets.x11=bytes.size"
+  else if s.regs.get? x12 != some (BitVec.ofNat 64 args.fixedSize) then
+    some "preCanonicalOffsets.x12=fixedSize"
+  else none
+
+theorem preCanonicalOffsets_failing_conjunct_agrees_with_mirror (env : DecoderEnvironment)
+    (args : CanonicalOffsetsArgs) (s : State) :
+    (preCanonicalOffsetsFailure? env args s).isNone = preCanonicalOffsetsB env args s := by
+  simp only [preCanonicalOffsetsFailure?, preCanonicalOffsetsB]
+  by_cases h1 : memoryBytesB s args.base args.bytes <;>
+    by_cases h2 : codeIntactB env.image s <;>
+    by_cases h3 : s.regs.get? x10 = some (BitVec.ofNat 64 args.base) <;>
+    by_cases h4 : s.regs.get? x11 = some (BitVec.ofNat 64 args.bytes.size) <;>
+    by_cases h5 : s.regs.get? x12 = some (BitVec.ofNat 64 args.fixedSize) <;>
+    simp_all
+
+/-! ## `postCanonicalOffsets`, and the three conjuncts that need no slice at all
+
+`postCanonicalOffsets`'s frame is `LeafFrame … 0 0` — the same record `postScalarRead` and
+`postBytesAt` use, because an offset-table check has no result record either. Splitting `MemoryBytes`
+off leaves three conjuncts that mention neither the record nor the argument slice, so they are
+decidable on a row whose slice is not materialisable at all. -/
+
+/-- The `LeafFrame … 0 0` conjuncts that mention neither the result record nor the argument slice. -/
+def leafFrameZeroRecordNoSliceB (env : DecoderEnvironment) (before after : State) : Bool :=
+  codeIntactB env.image after && noAllocationB before after && scalarWritesOnlyWithinB before after
+
+/-- **Implied by `LeafFrame … 0 0` at every `base`/`bytes`.** Both are universally quantified here,
+which is what makes this mirror sound to run on a row whose slice the harness cannot materialise:
+whatever the real slice was, a `false` here refutes the postcondition. -/
+theorem leafFrameZeroRecordNoSliceB_of_leafFrame {base : Nat} {bytes : ByteArray}
+    {before after : State}
+    (h : LeafFrame canonicalEnvironment base bytes 0 0 before after) :
+    leafFrameZeroRecordNoSliceB canonicalEnvironment before after = true := by
+  obtain ⟨-, hcode, hnoalloc, hwrites⟩ := h
+  simp only [leafFrameZeroRecordNoSliceB, Bool.and_eq_true]
+  exact ⟨⟨codeIntactB_of_fileBytesMatchMemory hcode, noAllocationB_of_noAllocation hnoalloc⟩,
+    (scalarWritesOnlyWithinB_iff before after).mpr hwrites⟩
+
+/-- The first slice-independent `LeafFrame … 0 0` conjunct that fails, by name. -/
+def leafFrameZeroRecordNoSliceFailure? (env : DecoderEnvironment) (before after : State) :
+    Option String :=
+  if !codeIntactB env.image after then some "LeafFrame.CodeIntact(after)"
+  else if !noAllocationB before after then some "LeafFrame.NoAllocation"
+  else if !scalarWritesOnlyWithinB before after then some "LeafFrame.WritesOnlyWithinOwnRecord"
+  else none
+
+theorem leafFrameZeroRecordNoSlice_failing_conjunct_agrees_with_mirror (env : DecoderEnvironment)
+    (before after : State) :
+    (leafFrameZeroRecordNoSliceFailure? env before after).isNone =
+      leafFrameZeroRecordNoSliceB env before after := by
+  simp only [leafFrameZeroRecordNoSliceFailure?, leafFrameZeroRecordNoSliceB]
+  by_cases h1 : codeIntactB env.image after <;>
+    by_cases h2 : noAllocationB before after <;>
+    by_cases h3 : scalarWritesOnlyWithinB before after <;> simp_all
+
+/-- Whether the machine left the accepting status `0` in `x10`. -/
+def canonicalOffsetsResultClauseB (after : State) : Bool :=
+  after.regs.get? x10 == some (BitVec.ofNat 64 0)
+
+/-- **`x10 = 0` settles `postCanonicalOffsets`'s result clause at every offset table.** The clause is
+`x10 = 0` on the accepting arm and `error = invalidSsz` on the rejecting one; the second is satisfied
+by *every* result this meaning can produce (`meaningRequireCanonicalOffsets_onlyInvalid`), so once
+`x10 = 0` both arms hold and the unpinned `offsets` argument cannot change it.
+
+**This is one-directional, and the direction matters.** `canonicalOffsetsResultClauseB = false` is
+*not* a refutation: a non-zero `x10` is consistent with the postcondition whenever the meaning
+rejects, and deciding which needs the `offsets` the artifact does not pin. So this mirror is read
+only as a pass, and the harness reports a gap rather than a violation when it is false. -/
+theorem canonicalOffsets_result_clause_of_x10_zero {after : State}
+    (h : canonicalOffsetsResultClauseB after = true)
+    (bytes : ByteArray) (fixedSize : Nat) (offsets : List Nat) :
+    (match meaningRequireCanonicalOffsets bytes fixedSize offsets with
+     | .ok () => after.regs.get? x10 = some (BitVec.ofNat 64 0)
+     | .error error => error = SszDecodeError.invalidSsz) := by
+  have hx10 : after.regs.get? x10 = some (BitVec.ofNat 64 0) := by
+    simpa [canonicalOffsetsResultClauseB] using h
+  cases hm : meaningRequireCanonicalOffsets bytes fixedSize offsets with
+  | ok value => cases value; exact hx10
+  | error error =>
+      exact meaningRequireCanonicalOffsets_onlyInvalid bytes fixedSize offsets error hm
+
+/-- The full `postCanonicalOffsets` mirror, for a row whose slice **is** materialisable. -/
+def postCanonicalOffsetsCheckedB (env : DecoderEnvironment) (args : CanonicalOffsetsArgs)
+    (result : Except SszDecodeError Unit) (before after : State) : Bool :=
+  leafFrameZeroRecordB env args.base args.bytes before after &&
+    (match result with
+     | .ok () => after.regs.get? x10 == some (BitVec.ofNat 64 0)
+     | .error error => error == SszDecodeError.invalidSsz)
+
+theorem postCanonicalOffsetsCheckedB_of_postCanonicalOffsets {args : CanonicalOffsetsArgs}
+    {result : Except SszDecodeError Unit} {before after : State}
+    (h : postCanonicalOffsets canonicalEnvironment args result before after) :
+    postCanonicalOffsetsCheckedB canonicalEnvironment args result before after = true := by
+  obtain ⟨hframe, harm⟩ := h
+  simp only [postCanonicalOffsetsCheckedB, Bool.and_eq_true]
+  refine ⟨leafFrameZeroRecordB_of_leafFrame hframe, ?_⟩
+  cases result with
+  | ok value => cases value; simpa using harm
+  | error error => simpa using harm
+
+/-- The first checked `postCanonicalOffsets` conjunct that fails, by name. -/
+def postCanonicalOffsetsFailure? (env : DecoderEnvironment) (args : CanonicalOffsetsArgs)
+    (result : Except SszDecodeError Unit) (before after : State) : Option String :=
+  match leafFrameZeroRecordFailure? env args.base args.bytes before after with
+  | some clause => some clause
+  | none =>
+      match result with
+      | .ok () =>
+          if after.regs.get? x10 != some (BitVec.ofNat 64 0) then
+            some "postCanonicalOffsets.x10=0"
+          else none
+      | .error error => if error != SszDecodeError.invalidSsz then
+          some "postCanonicalOffsets.error=invalidSsz" else none
+
+theorem postCanonicalOffsets_failing_conjunct_agrees_with_mirror (env : DecoderEnvironment)
+    (args : CanonicalOffsetsArgs) (result : Except SszDecodeError Unit) (before after : State) :
+    (postCanonicalOffsetsFailure? env args result before after).isNone =
+      postCanonicalOffsetsCheckedB env args result before after := by
+  simp only [postCanonicalOffsetsFailure?, postCanonicalOffsetsCheckedB,
+    ← leafFrameZeroRecord_failing_conjunct_agrees_with_mirror]
+  cases leafFrameZeroRecordFailure? env args.base args.bytes before after with
+  | some clause => simp
+  | none =>
+      cases result with
+      | ok value =>
+          cases value
+          by_cases h : after.regs.get? x10 = some (BitVec.ofNat 64 0) <;> simp_all
+      | error error => by_cases h : error = SszDecodeError.invalidSsz <;> simp_all
+
+/-- **`requireCanonicalOffsets`'s step bound is at least 32 at every argument tuple**, because it is
+`32 + 32 · |offsets|`. A run that retires at most 32 steps is therefore inside the bound whatever
+offset table the caller passed. Going the other way needs an *upper* bound on `|offsets|`, which Row
+A does not pin, so a longer run is a gap and never a refutation. -/
+theorem canonicalOffsets_stepBound_is_at_least_32 (env : DecoderEnvironment)
+    (args : CanonicalOffsetsArgs) :
+    32 ≤ (contractRequireCanonicalOffsets env).stepBound args :=
+  Nat.le_add_right 32 _
+
+/-- The `|offsets| = 0` step bound, the only instance of `stepBound` the harness can evaluate. -/
+def canonicalOffsetsMinimumStepBound : Nat :=
+  (contractRequireCanonicalOffsets canonicalEnvironment).stepBound
+    { base := 0, bytes := ByteArray.empty, fixedSize := 0, offsets := [] }
+
+/-! ## Reading a register and a Row A binding out of a captured state -/
+
+/-- The value of integer register `number` as a `Nat`, executably. Mirrors `RegisterValueRep`'s
+dispatch on the same numbering. -/
+def registerValue? (s : State) (number : Nat) : Option (BitVec 64) :=
+  match number with
+  | 1 => s.regs.get? x1 | 2 => s.regs.get? x2 | 3 => s.regs.get? x3 | 4 => s.regs.get? x4
+  | 5 => s.regs.get? x5 | 6 => s.regs.get? x6 | 7 => s.regs.get? x7 | 8 => s.regs.get? x8
+  | 9 => s.regs.get? x9 | 10 => s.regs.get? x10 | 11 => s.regs.get? x11 | 12 => s.regs.get? x12
+  | 13 => s.regs.get? x13 | 14 => s.regs.get? x14 | 15 => s.regs.get? x15 | 16 => s.regs.get? x16
+  | 17 => s.regs.get? x17 | 18 => s.regs.get? x18 | 19 => s.regs.get? x19 | 20 => s.regs.get? x20
+  | 21 => s.regs.get? x21 | 22 => s.regs.get? x22 | 23 => s.regs.get? x23 | 24 => s.regs.get? x24
+  | 25 => s.regs.get? x25 | 26 => s.regs.get? x26 | 27 => s.regs.get? x27 | 28 => s.regs.get? x28
+  | 29 => s.regs.get? x29 | 30 => s.regs.get? x30 | 31 => s.regs.get? x31
+  | _ => some (0 : BitVec 64)
+
+/-- The value a Row A binding row denotes at a state, or `none` when the kind resolves to no value
+here. Follows `BindingInventory.bindingRowHolds` case for case; kinds it cannot evaluate return
+`none` and become an explicit gap rather than a guess. -/
+def bindingValue? (row : Nat × String × String × Int × Int) (s : State) : Option Nat :=
+  let (_, _, kind, registerOrAddress, offsetOrValue) := row
+  if kind = "const" then some offsetOrValue.toNat
+  else if kind = "reg" then (registerValue? s registerOrAddress.toNat).map BitVec.toNat
+  else if kind = "bregValue" then
+    (registerValue? s registerOrAddress.toNat).map fun base =>
+      Elfling.addSignedOffset base.toNat offsetOrValue
+  else if kind = "addrValue" then some registerOrAddress.toNat
+  else if kind = "addr" then observeWord64? s registerOrAddress.toNat
+  else if kind = "breg" ∨ kind = "fbreg" then
+    match registerValue? s registerOrAddress.toNat with
+    | some base => observeWord64? s (Elfling.addSignedOffset base.toNat offsetOrValue)
+    | none => none
+  else if kind = "derived" then
+    (registerValue? s registerOrAddress.toNat).map fun base => base.toNat + offsetOrValue.toNat
+  else none
+
+/-- Row A's `offset` binding row for instance `index`, if it declares one. -/
+def offsetBindingRow? (index : Nat) :
+    Option (Nat × String × String × Int × Int) :=
+  Elfling.GeneratedBindings.bindings.find? fun r => r.1 == index && r.2.1 == "offset"
+
+/-- Row A's `len` binding row for instance `index` (`bytesAt` only). -/
+def lenBindingRow? (index : Nat) : Option (Nat × String × String × Int × Int) :=
+  Elfling.GeneratedBindings.bindings.find? fun r => r.1 == index && r.2.1 == "len"
+
+
+/-- Row A's binding row for an arbitrary named parameter of `index`. -/
+def bindingRow? (index : Nat) (name : String) :
+    Option (Nat × String × String × Int × Int) :=
+  Elfling.GeneratedBindings.bindings.find? fun r => r.1 == index && r.2.1 == name
+
+/-- Row A's row for a named parameter of instance `index`, whatever the parameter is called. -/
+def namedBindingRow? (index : Nat) (name : String) :
+    Option (Nat × String × String × Int × Int) :=
+  Elfling.GeneratedBindings.bindings.find? fun r => r.1 == index && r.2.1 == name
+
+/-- **The ADDRESS a Row A location denotes**, as opposed to the value stored there.
+
+This distinction is not decorative and getting it wrong manufactures refutations. DWARF's `breg`/
+`fbreg` say *"the object lives at `reg + offset`"*, so the object's address is `reg + offset` and its
+value is the word there; `bregValue` is the form that says the value *is* `reg + offset`.
+`bindingValue?` implements the value reading, which is right for a scalar parameter like `offset` and
+**wrong** for a by-reference aggregate like `alloc`, whose contract-level argument
+(`EntryArgs.allocatorBase`, `CollectionArgs.allocatorBase`) is the address of the allocator object.
+`decodeRaw_and_byteListList_alloc_binding_is_an_address` below exhibits the two numbers side by side
+so the choice can be checked rather than believed. -/
+def bindingAddress? (row : Nat × String × String × Int × Int) (s : State) : Option Nat :=
+  let (_, _, kind, registerOrAddress, offsetOrValue) := row
+  if kind = "breg" ∨ kind = "fbreg" then
+    (registerValue? s registerOrAddress.toNat).map fun base =>
+      Elfling.addSignedOffset base.toNat offsetOrValue
+  else if kind = "addr" ∨ kind = "addrValue" then some registerOrAddress.toNat
+  else none
+
+/-- Row A's `fixed_size` binding row for instance `index` (`requireCanonicalOffsets` only). The
+parameter is spelled `fixed_size` in the artifact, which is the Zig identifier, not the contract's
+`fixedSize` field name — the harness reads the artifact's spelling rather than the contract's. -/
+def fixedSizeBindingRow? (index : Nat) : Option (Nat × String × String × Int × Int) :=
+  Elfling.GeneratedBindings.bindings.find? fun r => r.1 == index && r.2.1 == "fixed_size"
+
+/-- **Row A pins exactly one of `requireCanonicalOffsets`'s four contract arguments.** `fixed_size`
+is bound, and `data` / `offsets` are not bound anywhere in the artifact — the compiler passes both as
+two-register slices and the DWARF extractor emits no row for them. So `base`, `bytes` and `offsets`
+are all unpinned here, which is what makes the `offsets`-dependent clauses gaps rather than checks. -/
+theorem requireCanonicalOffsets_binding_rows :
+    (Elfling.GeneratedBindings.bindings.filterMap fun r =>
+      if r.1 == 134 then some (r.2.1, r.2.2.1, r.2.2.2.1) else none) =
+      [("fixed_size", "reg", 11)] := by native_decide
+
+
+/-! ## Licensing a `post` pass, and refusing to license the rest
+
+An `ok` in column 4 is a claim that the real `post` **holds**. Every mirror above is stated as
+`Prop → mirror = true`, which is the refuting direction and does not support that claim: a `true`
+mirror is consistent with the predicate being false unless the implication also runs backwards.
+
+`postCopy` is the one postcondition in this module whose mirror is proved in both directions, so it
+is the one whose `ok` is reported. Everything else that would otherwise reach `ok` is downgraded to
+an explicit gap, either here or in the verdict functions further down. -/
+
+/-- **`postCopyCheckedB` decides `postCopy` exactly.** All four conjuncts are equivalences:
+`codeIntactB_iff`, `noAllocationB_iff`, `copyWritesOnlyWithinB_iff` and `memoryBytesB_iff`. The
+`.error` arm is `False` on both sides. This — and not `postCopyCheckedB_of_postCopy` — is what
+licenses a copy row's `post` cell to read `ok`. -/
+theorem postCopyCheckedB_iff_postCopy {args : CopyArgs}
+    {result : Except SszDecodeError ByteArray} {before after : State} :
+    postCopyCheckedB canonicalEnvironment args result before after = true ↔
+      postCopy canonicalEnvironment args result before after := by
+  simp only [postCopyCheckedB, postCopy, Bool.and_eq_true, codeIntactB_iff, noAllocationB_iff,
+    copyWritesOnlyWithinB_iff, and_assoc]
+  refine and_congr Iff.rfl (and_congr Iff.rfl (and_congr Iff.rfl ?_))
+  cases result with
+  | ok contents => exact memoryBytesB_iff
+  | error error => simp
+
+/-- The failure-namer's `none` is exactly the predicate, by composing the agreement theorem with the
+equivalence above. This is the form the verdict function uses. -/
+theorem postCopyFailure?_isNone_iff {args : CopyArgs}
+    {result : Except SszDecodeError ByteArray} {before after : State} :
+    (postCopyFailure? canonicalEnvironment args result before after).isNone = true ↔
+      postCopy canonicalEnvironment args result before after := by
+  rw [← postCopyCheckedB_iff_postCopy,
+    postCopy_failing_conjunct_agrees_with_mirror canonicalEnvironment args result before after]
+
+/-- `LeafFrame … 0 0` is decided exactly by `leafFrameZeroRecordB`. Every read-family postcondition
+opens with it, so this is the shared half of the two equivalences below. -/
+theorem leafFrameZeroRecordB_iff {base : Nat} {bytes : ByteArray} {before after : State} :
+    leafFrameZeroRecordB canonicalEnvironment base bytes before after = true ↔
+      LeafFrame canonicalEnvironment base bytes 0 0 before after := by
+  simp only [leafFrameZeroRecordB, leafFrameSharedB, LeafFrame, Bool.and_eq_true, memoryBytesB_iff,
+    codeIntactB_iff, noAllocationB_iff, scalarWritesOnlyWithinB_iff, and_assoc]
+  -- `env.CodeIntact` unfolds to `env.image.fileBytesMatchMemory`, which is what `codeIntactB_iff`
+  -- produced; the two sides are then definitionally the same conjunction.
+  rfl
+
+/-- **`postScalarReadCheckedB` decides `postScalarRead` exactly.** The reviewer's conjecture that
+the mirrors are complete in fact is discharged here rather than assumed: with the three converses
+above, every conjunct is an equivalence. -/
+theorem postScalarReadCheckedB_iff_postScalarRead {args : ReadAtArgs} {width : Nat}
+    {result : Except SszDecodeError Nat} {before after : State} :
+    postScalarReadCheckedB canonicalEnvironment args width result before after = true ↔
+      postScalarRead canonicalEnvironment args width result before after := by
+  simp only [postScalarReadCheckedB, postScalarRead, Bool.and_eq_true, leafFrameZeroRecordB_iff]
+  refine and_congr Iff.rfl ?_
+  cases result with
+  | ok value => simp
+  | error error => simp
+
+/-- **`postBytesAtCheckedB` decides `postBytesAt` exactly**, for the same reason. -/
+theorem postBytesAtCheckedB_iff_postBytesAt {args : BytesAtArgs}
+    {result : Except SszDecodeError ByteArray} {before after : State} :
+    postBytesAtCheckedB canonicalEnvironment args result before after = true ↔
+      postBytesAt canonicalEnvironment args result before after := by
+  simp only [postBytesAtCheckedB, postBytesAt, Bool.and_eq_true, leafFrameZeroRecordB_iff]
+  refine and_congr Iff.rfl ?_
+  cases result with
+  | ok slice => simp
+  | error error => simp
+
+/-! ### Which conjuncts a `reg` binding turns into `x == x`
+
+The harness's whole method is to take an argument from **Row A** and compare it against the register
+the contract names. That comparison carries information exactly when the two disagree about where
+the value lives. When Row A's binding kind is `reg` at the very register the conjunct constrains,
+`bindingValue?` *is* `registerValue?` at that register, and the conjunct degenerates to `x == x`.
+
+This is not a hypothesis about the artifact — it is proved below, and then measured per row. It is
+why the read family's hundred refutations are evidence (Row A answers `x9`/`x18`/`x19`/`x24`/`x27`
+or a constant there) and why the copy and `rawAlloc` rows' register conjuncts are not. -/
+
+/-- Whether a Row A row says "this parameter lives in integer register `number`". -/
+def bindingNamesRegister (row : Nat × String × String × Int × Int) (number : Nat) : Bool :=
+  row.2.2.1 == "reg" && row.2.2.2.1 == (number : Int)
+
+/-- At a `reg n` binding, `bindingValue?` is literally the register read. -/
+theorem bindingValue?_at_reg_binding (s : State) (row : Nat × String × String × Int × Int)
+    (number : Nat) (h : bindingNamesRegister row number = true) :
+    bindingValue? row s = (registerValue? s number).map BitVec.toNat := by
+  obtain ⟨rowIndex, name, kind, registerOrAddress, offsetOrValue⟩ := row
+  simp only [bindingNamesRegister, Bool.and_eq_true, beq_iff_eq] at h
+  obtain ⟨hkind, hregister⟩ := h
+  subst hkind
+  subst hregister
+  simp [bindingValue?]
+
+/-- **A `reg n` binding makes the register conjunct unfalsifiable.** If Row A binds the argument to
+register `number` and the harness reads a value out of that binding, then the register really does
+hold `BitVec.ofNat 64 value` — whatever the machine put there. So a conjunct of the form
+`s.regs.get? xn = some (BitVec.ofNat 64 argument)` is `x == x` at such a row and must never be
+counted as a check that passed. -/
+theorem register_conjunct_is_a_tautology_at_a_reg_binding (s : State)
+    (row : Nat × String × String × Int × Int) (number value : Nat)
+    (hreg : bindingNamesRegister row number = true)
+    (hvalue : bindingValue? row s = some value) :
+    registerValue? s number = some (BitVec.ofNat 64 value) := by
+  rw [bindingValue?_at_reg_binding s row number hreg] at hvalue
+  obtain ⟨bits, hbits, hvalue'⟩ := Option.map_eq_some_iff.mp hvalue
+  subst hvalue'
+  rw [hbits]
+  simp
+
+/-! ### `postAlloc`'s success arm, split into what the machine can move and what it cannot
+
+`address ≠ 0`, `alignment ≠ 0` and `address % alignment = 0` are computed from the reconstructed
+`args` and from the address `contractAlloc`'s own `meaning` returned. **They mention neither captured
+state.** The decomposition below proves that: the success arm factors as a state-free conjunction
+`&&` a state-dependent one. No run can make the state-free factor false that another run would make
+true, so a verdict must not rest on it.
+
+The allocator family's own anti-vacuity probe had to hand the mirror an `args` record inconsistent
+with the `result` computed from a *different* `args` in order to make `postAlloc.alignment≠0` fire.
+That is a test of the mirror, not a perturbation the machine can produce, and the split states
+exactly why. -/
+
+/-- The `postAlloc` success-arm conjuncts that mention no captured state. -/
+def postAllocModelClausesB (args : AllocArgs) (address : Nat) : Bool :=
+  decide (address ≠ 0) && decide (args.alignment ≠ 0) && decide (address % args.alignment = 0)
+
+/-- The `postAlloc` success-arm conjuncts that do. -/
+def postAllocMachineClausesB (env : DecoderEnvironment) (args : AllocArgs) (address : Nat)
+    (before after : State) : Bool :=
+  (after.regs.get? x10 == some (BitVec.ofNat 64 address)) &&
+    (match env.cursor? before, env.cursor? after with
+     | some cursorBefore, some cursorAfter =>
+         allocCursorBlockB args address cursorBefore cursorAfter before after
+     | _, _ => false)
+
+/-- **The success arm factors.** Three of its conjuncts are a function of `(args, address)` alone. -/
+theorem postAllocSuccessB_splits (env : DecoderEnvironment) (args : AllocArgs) (address : Nat)
+    (before after : State) :
+    postAllocSuccessB env args address before after =
+      (postAllocModelClausesB args address &&
+        postAllocMachineClausesB env args address before after) := by
+  simp only [postAllocSuccessB, postAllocModelClausesB, postAllocMachineClausesB,
+    Bool.and_assoc]
+
+-- `postAllocModelClausesB` takes no `State` argument at all: that, together with
+-- `postAllocSuccessB_splits`, *is* the statement that no run can move those three conjuncts. A
+-- separate `∀ before after, … = …` lemma would be `rfl` and would carry no content, so none is
+-- stated.
+
+/-- The first *machine-dependent* `postAlloc` success-arm conjunct that fails, by name. The three
+state-free clauses are deliberately not consulted: they are reported separately, and a pass that
+rested on them would be reporting a tautology as a measurement. -/
+def postAllocMachineFailure? (env : DecoderEnvironment) (args : AllocArgs) (address : Nat)
+    (before after : State) : Option String :=
+  if after.regs.get? x10 != some (BitVec.ofNat 64 address) then some "postAlloc.x10=address"
+  else
+    match env.cursor? before, env.cursor? after with
+    | some cursorBefore, some cursorAfter =>
+        allocCursorBlockFailure? args address cursorBefore cursorAfter before after
+    | none, _ => some "postAlloc.cursor?(before)=some"
+    | _, none => some "postAlloc.cursor?(after)=some"
+
+theorem postAllocMachineFailure?_agrees (env : DecoderEnvironment) (args : AllocArgs)
+    (address : Nat) (before after : State) :
+    (postAllocMachineFailure? env args address before after).isNone =
+      postAllocMachineClausesB env args address before after := by
+  simp only [postAllocMachineFailure?, postAllocMachineClausesB, ← allocCursorBlock_agrees]
+  by_cases h : after.regs.get? x10 = some (BitVec.ofNat 64 address) <;>
+    cases hb : env.cursor? before <;> cases ha : env.cursor? after <;> simp_all
+
+/-- **Row A declares no `base` and no `bytes.size` binding anywhere in the read family.** This is why
+those two arguments are witness-constructed rather than independently supplied, and it is a
+contract-interface gap rather than a harness gap: nothing in the artifact pins them. -/
+theorem read_family_declares_no_base_or_size_binding :
+    (Elfling.GeneratedBindings.bindings.filter fun r =>
+      r.2.1 == "data" || r.2.1 == "base" || r.2.1 == "bytes" && r.2.2.1 != "reg").length = 0 := by
+  native_decide
+
+/-! ## The instrumented run
+
+The same Sail machine `RunnerExecution` drives, with one addition: before each retirement the pc is
+looked up in a boundary index, and the state is snapshotted when it is a declared entry or exit.
+Only the FIRST entry of each instance and the first declared exit strictly after it are kept, which
+is what makes the capture bounded. -/
+
+/-- What the run recorded for one instance. Every field is `Option`: absent means the run never got
+there, which is a gap. -/
+structure InstanceCapture where
+  entryStep : Option Nat
+  entryState : Option State
+  exitStep : Option Nat
+  exitState : Option State
+  exitPc : Option Nat
+
+instance : Inhabited InstanceCapture := ⟨⟨none, none, none, none, none⟩⟩
+
+/-- pc → the instances declaring it their entry. -/
+def entryIndex : Std.HashMap Nat (Array Nat) :=
+  generatedProgram.functionInstances.zipIdx.foldl (fun m (o, i) =>
+    m.insert o.entryPc ((m.getD o.entryPc #[]).push i)) ∅
+
+/-- pc → the instances declaring it an exit. -/
+def exitIndex : Std.HashMap Nat (Array Nat) :=
+  generatedProgram.functionInstances.zipIdx.foldl (fun m (o, i) =>
+    o.exitPcs.foldl (fun m pc => m.insert pc ((m.getD pc #[]).push i)) m) ∅
+
+def emptyCaptures : Array InstanceCapture :=
+  Array.replicate generatedProgram.functionInstances.size default
+
+/-- One instrumented step loop. Identical to `runToOutcome` except for the snapshot. -/
+def stepCapturing (sentinel : BitVec 64) :
+    Nat → Nat → Array InstanceCapture → SailM (SentinelOutcome × Array InstanceCapture)
+  | 0, _, caps => pure (.exhausted, caps)
+  | fuel + 1, steps, caps => do
+    let pc ← readReg PC
+    if pc == sentinel then pure (.reached steps, caps)
+    else
+      let address := pc.toNat
+      let entries := entryIndex.getD address #[]
+      let exits := exitIndex.getD address #[]
+      let caps ←
+        if entries.isEmpty && exits.isEmpty then pure caps
+        else do
+          let s ← EStateM.get
+          let caps := entries.foldl (fun (caps : Array InstanceCapture) i =>
+            let c := caps[i]!
+            if c.entryStep.isNone then
+              caps.set! i { c with entryStep := some steps, entryState := some s }
+            else caps) caps
+          let caps := exits.foldl (fun (caps : Array InstanceCapture) i =>
+            let c := caps[i]!
+            match c.entryStep, c.exitStep with
+            | some entered, none =>
+                if entered < steps then
+                  caps.set! i { c with exitStep := some steps, exitState := some s,
+                                       exitPc := some address }
+                else caps
+            | _, _ => caps) caps
+          pure caps
+      let waiting ← try_step steps false
+      if waiting then pure (.trapped, caps)
+      else stepCapturing sentinel fuel (steps + 1) caps
+
+def captureRun (input : ByteArray) : SailM (SentinelOutcome × Array InstanceCapture) := do
+  buildZesuEntryState input
+  stepCapturing sentinelWord (zesuFuel input.size) 0 emptyCaptures
+
+/-- The corpus case the capture runs on: the rich accepted fixture, the analogue of the trace
+tooling's `present` arm. -/
+def captureCaseId : String := "valid-v4-rich-raw"
+
+def captureInput : ByteArray :=
+  match GeneratedCorpus.corpus.find? fun c => c.1 == captureCaseId with
+  | some c => BinaryFv.SSZ.Zesu.Validation.hexToBytes c.2.2
+  | none => ByteArray.empty
+
+/-- The capture, as a value. A Sail fault yields `.trapped` with whatever was captured before it,
+which the report shows as gaps rather than as passes. -/
+def capture : SentinelOutcome × Array InstanceCapture :=
+  match (captureRun captureInput).run initialState with
+  | .ok result _ => result
+  | .error _ _ => (.trapped, emptyCaptures)
+
+def captureOutcome : SentinelOutcome := capture.1
+def captures : Array InstanceCapture := capture.2
+
+/-! ## Reconstructing the read-family arguments -/
+
+/-- The read-family tags, as the manifest spells them. An unrecognised tag is a gap, never a pass, so
+a catalog rename makes instances drop out of the checked set rather than silently pass. -/
+inductive ReadFamily where
+  | readU32 | readU64 | readOffset | readU256 | bytesAt | readArray
+deriving DecidableEq, Repr, Inhabited
+
+def readFamily? (tagName : String) : Option ReadFamily :=
+  if tagName = "readU32" then some .readU32
+  else if tagName = "readU64" then some .readU64
+  else if tagName = "readOffset" then some .readOffset
+  else if tagName = "readU256" then some .readU256
+  else if tagName = "bytesAt" then some .bytesAt
+  else if tagName = "readArray" then some .readArray
+  else none
+
+
+/-- The four **emitted decoder** tags, as the manifest spells them. Same discipline as `readFamily?`:
+an unrecognised tag is a gap, never a pass. -/
+inductive DecoderFamily where
+  | zesuDecodeRaw | decodeRaw | optionalU64 | byteListList
+deriving DecidableEq, Repr, Inhabited
+
+def decoderFamily? (tagName : String) : Option DecoderFamily :=
+  if tagName = "zesuDecodeRaw" then some .zesuDecodeRaw
+  else if tagName = "decodeRaw" then some .decodeRaw
+  else if tagName = "optionalU64" then some .optionalU64
+  else if tagName = "byteListList" then some .byteListList
+  else none
+
+/-- **The four decoder tags this module wires are all `emitted`, and every other instance carrying
+one of those tags would be too.** The generated manifest's own `kind` field says so, which is what
+makes the register-shaped precondition a meaningful question about them rather than the category
+error it is on an inlined instance. -/
+theorem decoder_family_instances_are_emitted :
+    (generatedManifest.filterMap fun row =>
+      if (decoderFamily? row.routineTag).isSome then some (row.index, row.kind) else none) =
+      #[(1, "emitted"), (6, "emitted"), (124, "emitted"), (126, "emitted")] := by native_decide
+
+/-- The **validation family**: routines that check a body and return only a status. Kept apart from
+`ReadFamily` because their contracts are a different shape — `preCanonicalOffsets` /
+`postCanonicalOffsets` rather than `preReadAt` / `postScalarRead` — and because the one instance in
+it is *emitted* rather than inlined, so its argument registers are a real ABI rather than whatever
+the inliner happened to choose. Same discipline as `readFamily?`: an unrecognised tag is a gap. -/
+inductive ValidationFamily where
+  | requireCanonicalOffsets
+deriving DecidableEq, Repr, Inhabited
+
+def validationFamily? (tagName : String) : Option ValidationFamily :=
+  if tagName = "requireCanonicalOffsets" then some .requireCanonicalOffsets else none
+
+/-- **The validation family is exactly one instance on this artifact, and it is emitted.** Recorded
+because it is what licenses reading `x10`/`x11`/`x12` here as an argument-passing convention at all.
+-/
+theorem validation_family_instances :
+    (generatedManifest.zipIdx.filterMap fun (m, i) =>
+      if (validationFamily? m.routineTag).isSome then
+        some (i, generatedProgram.functionInstances[i]!.entryPc, m.kind)
+      else none) = #[(134, 79648, "emitted")] := by native_decide
+
+/-- **And every read-family instance is inlined — none is emitted.** 108 of the 141 instances carry a
+read-family tag and the artifact marks all 108 `inlined`, so on those rows there is no call and the
+compiler owed no calling convention at all. That is what the hundred `preReadAt.x12=offset`
+refutations are refutations of: a register discipline the binary was never obliged to follow there.
+The count is pinned beside the emptiness so the check cannot pass by matching nothing. -/
+theorem read_family_instances_are_all_inlined :
+    ((generatedManifest.filter fun m => (readFamily? m.routineTag).isSome).size,
+     generatedManifest.zipIdx.filterMap fun (m, i) =>
+       if (readFamily? m.routineTag).isSome && m.kind != "inlined" then some (i, m.kind) else none)
+      = (108, #[]) := by native_decide
+
+/-- The largest borrowed slice the harness will materialise out of memory. A larger `x11` is reported
+as a gap: reading an arbitrary register-sized window would be a denial of service, not a check. -/
+def maximumSliceBytes : Nat := 8192
+
+/-- Read `size` bytes of machine memory at `base`, or `none` if any byte is unmapped or the window is
+oversized. -/
+def readSlice? (s : State) (base size : Nat) : Option ByteArray :=
+  if size > maximumSliceBytes then none
+  else
+    (List.range size).foldl (fun acc index =>
+      match acc, s.mem.get? (base + index) with
+      | some bytes, some byte => some (bytes.push (UInt8.ofNat byte.toNat))
+      | _, _ => none) (some ByteArray.empty)
+
+/-- The reconstructed `ReadAtArgs` for an instance at its captured entry state: `offset` from Row A,
+`base`/`bytes` witness-constructed from `x10`/`x11` (see the module docstring). -/
+def readAtArgs? (index : Nat) (s : State) : Option ReadAtArgs := do
+  let row ← offsetBindingRow? index
+  let offset ← bindingValue? row s
+  let base ← (registerValue? s 10).map BitVec.toNat
+  let size ← (registerValue? s 11).map BitVec.toNat
+  let bytes ← readSlice? s base size
+  pure { base := base, bytes := bytes, offset := offset }
+
+/-- The reconstructed `BytesAtArgs`: the read-at args plus Row A's `len` binding, evaluated at the
+same captured entry state. Unlike `readU256`/`readArray`'s `resultBase`, this argument **is** pinned
+by the generated binding artifact, which is why `bytesAt`'s `post` needs no witness beyond the ones
+`preReadAt` already needed. -/
+def bytesAtArgs? (index : Nat) (s : State) : Option BytesAtArgs := do
+  let readArgs ← readAtArgs? index s
+  let row ← lenBindingRow? index
+  let length ← bindingValue? row s
+  pure { toReadAtArgs := readArgs, length := length }
+
+
+/-! ## Reconstructing the allocator-family arguments
+
+The five allocator instances are `kind := "emitted"` in the generated manifest, i.e. real call
+boundaries, so `a0`/`a1` in their preconditions denote the RISC-V argument registers rather than
+whatever the compiler happened to leave in a register mid-body. That is what makes a register-shaped
+precondition a question here at all.
+
+Three of the five take no arguments (`Args = Unit`), so nothing is reconstructed for them. The two
+allocation sites take `AllocArgs`, whose `bytes` and `alignment` Row A *does* bind — and, at the
+vtable thunk, binds to different registers than `preAlloc` names. That disagreement is the finding. -/
+
+/-- The read family's tags and the allocator family's tags are disjoint, so the two dispatches can
+be tried in sequence without either shadowing the other. Trivial, but it is what licenses the
+`match readFamily? tag with | none => allocFamily? tag` shape in `groundTruthRow`. -/
+inductive AllocFamily where
+  | rawAlloc | allocatorAlloc | allocatorFree | allocatorRemap | allocatorResize
+deriving DecidableEq, Repr, Inhabited
+
+/-- `allocatorCtor` is deliberately **absent**: its `AllocatorCtorArgs` carries `contextBase`,
+`vtableBase` and `resultBase`, none of which Row A binds, so it stays an explicit gap rather than
+being wired with three invented witnesses. -/
+def allocFamily? (tagName : String) : Option AllocFamily :=
+  if tagName = "rawAlloc" then some .rawAlloc
+  else if tagName = "allocatorAlloc" then some .allocatorAlloc
+  else if tagName = "allocatorFree" then some .allocatorFree
+  else if tagName = "allocatorRemap" then some .allocatorRemap
+  else if tagName = "allocatorResize" then some .allocatorResize
+  else none
+
+/-- Row A's row for the allocation size. The freestanding `zesu_raw_alloc` calls the parameter
+`bytes`; the vtable thunk calls it `len`. Both names are tried, in that order. -/
+def allocBytesBindingRow? (index : Nat) : Option (Nat × String × String × Int × Int) :=
+  match Elfling.GeneratedBindings.bindings.find? fun r => r.1 == index && r.2.1 == "bytes" with
+  | some row => some row
+  | none => Elfling.GeneratedBindings.bindings.find? fun r => r.1 == index && r.2.1 == "len"
+
+/-- Row A's row for the allocation alignment. -/
+def allocAlignmentBindingRow? (index : Nat) : Option (Nat × String × String × Int × Int) :=
+  Elfling.GeneratedBindings.bindings.find? fun r => r.1 == index && r.2.1 == "alignment"
+
+/-- The reconstructed `AllocArgs`, **both** value-carrying fields from Row A. `allocatorBase` is set
+to `0`; see `allocArgs_allocatorBase_is_inert` for why that materialises nothing. -/
+def allocArgs? (index : Nat) (s : State) : Option AllocArgs := do
+  let bytesRow ← allocBytesBindingRow? index
+  let bytes ← bindingValue? bytesRow s
+  let alignmentRow ← allocAlignmentBindingRow? index
+  let alignment ← bindingValue? alignmentRow s
+  pure { allocatorBase := 0, bytes := bytes, alignment := alignment }
+
+/-- **`AllocArgs.allocatorBase` is named by the record and used by nothing.** `preAlloc`, `postAlloc`
+and `contractAlloc.meaning` are all literally invariant in it, so the `0` above is not a witness: no
+choice of value can make any conjunct true that another choice would make false. Proved by `rfl`
+rather than argued, so a future contract that *starts* using the field breaks this instead of
+silently turning the `0` into an unjustified witness. -/
+theorem allocArgs_allocatorBase_is_inert (env : DecoderEnvironment)
+    (heap : BinaryFv.SSZ.Zesu.Runtime.BumpHeap) (a b bytes alignment : Nat)
+    (result : Except SszDecodeError Nat) (s before after : State) :
+    (preAlloc env ⟨a, bytes, alignment⟩ s ↔ preAlloc env ⟨b, bytes, alignment⟩ s) ∧
+      (postAlloc env ⟨a, bytes, alignment⟩ result before after ↔
+        postAlloc env ⟨b, bytes, alignment⟩ result before after) ∧
+      (contractAlloc env heap).meaning ⟨a, bytes, alignment⟩ =
+        (contractAlloc env heap).meaning ⟨b, bytes, alignment⟩ :=
+  ⟨Iff.rfl, Iff.rfl, rfl⟩
+
+/-- Whether a Row A row says "this parameter lives in integer register `number`". -/
+def bindingIsRegister (row : Nat × String × String × Int × Int) (number : Nat) : Bool :=
+  row.2.2.1 == "reg" && row.2.2.2.1 == (number : Int)
+
+/-- **Whether Row A puts the two allocation arguments in the registers `preAlloc` names.**
+
+This is the state-independent half of the `pre` question, and it is the half that carries the
+information. When it is `false`, the register conjuncts are asking something the artifact can fail —
+and at index 136 they do. When it is `true`, the argument was read out of the very register the
+conjunct constrains, so the conjunct is a **tautology** and the row's `pre` pass is `ok@witness-args`
+in exactly the sense the read family already uses. -/
+def allocBindingMatchesAbi (index : Nat) : Bool :=
+  (match allocBytesBindingRow? index with
+   | some row => bindingIsRegister row 10
+   | none => false) &&
+    (match allocAlignmentBindingRow? index with
+     | some row => bindingIsRegister row 11
+     | none => false)
+
+/-- The allocator family's `stepBound`, read off the real contracts. `contractAlloc`'s is a constant
+function of its arguments (`alloc_stepBound_ignores_args`), and the other three take no arguments at
+all, so no witness is involved in column 5 for any of these five rows. -/
+def allocFamilyStepBound (family : AllocFamily) : Nat :=
+  match family with
+  | .rawAlloc | .allocatorAlloc =>
+      (contractAlloc canonicalEnvironment canonicalHeap).stepBound
+        { allocatorBase := 0, bytes := 0, alignment := 0 }
+  | .allocatorFree => (contractAllocatorFree canonicalEnvironment).stepBound ()
+  | .allocatorRemap => (contractAllocatorRemap canonicalEnvironment).stepBound ()
+  | .allocatorResize => (contractAllocatorResize canonicalEnvironment).stepBound ()
+
+theorem alloc_stepBound_ignores_args (env : DecoderEnvironment)
+    (heap : BinaryFv.SSZ.Zesu.Runtime.BumpHeap) (a b : AllocArgs) :
