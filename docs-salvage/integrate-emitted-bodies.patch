+/-- Per copy row: whether the destination already held the copied bytes at ENTRY, whether it holds
+them at EXIT, and whether the ownership clause still passes once the destination record is shrunk to
+nothing. -/
+def copyPostScope? : Array (Option (Nat × Bool × Bool × Bool × Nat)) :=
+  #[139, 140].map fun index => do
+    let before ← captures[index]!.entryState
+    let after ← captures[index]!.exitState
+    let args ← copyArgs? index before
+    pure (index,
+      memoryBytesB before args.destination args.contents,
+      memoryBytesB after args.destination args.contents,
+      copyWritesOnlyWithinB args.destination 0 before after,
+      firstWriteFrameViolation (copyOwnedB args.destination 0) before after)
