+     (groundTruthRows.filter fun r => r.entered.isViolated).size,
+     (groundTruthRows.filter fun r => r.pre.isOk).size,
+     (groundTruthRows.filter fun r => r.pre.isViolated).size,
+     (groundTruthRows.filter fun r => r.exited.isOk).size,
