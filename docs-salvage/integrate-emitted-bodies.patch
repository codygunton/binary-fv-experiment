+The `steps` numbers are one point on each contract's line, not the line: `64 + 8 * 256 = 2112` and
+`64 + 16 * 20 = 384` are bounds for *these* lengths only. -/
+theorem copy_rows_are_decided_and_post_passes :
+    (copyRowVerdicts?.map fun row =>
+      (row.1, row.2.1,
+       [row.2.2.1.isOk, row.2.2.2.1.isOk, row.2.2.2.2.1.isOk, row.2.2.2.2.2.1.isOk,
+        row.2.2.2.2.2.2.1.isOk],
+       [row.2.2.1.isViolated, row.2.2.2.1.isViolated, row.2.2.2.2.1.isViolated,
+        row.2.2.2.2.2.1.isViolated, row.2.2.2.2.2.2.1.isViolated],
+       row.2.2.2.2.2.2.2.1, row.2.2.2.2.2.2.2.2)) =
+      #[(139, "memcpy", [true, false, true, true, true], [false, false, false, false, false],
+          some 1794, some 2112),
+        (140, "memmove", [true, false, true, true, true], [false, false, false, false, false],
+          some 124, some 384)] := by native_decide
+
+/-- Per copy row: the Row A argument beside the register value `preCopy` compares it against, and the
+witnessed slice's size beside the length it is required to equal. -/
+def copyArgumentEvidence? : Array (Option (Nat × (Nat × Nat) × (Nat × Nat) × (Nat × Nat) × Nat)) :=
+  #[139, 140].map fun index => do
+    let s ← captures[index]!.entryState
+    let args ← copyArgs? index s
+    let real10 ← (registerValue? s 10).map BitVec.toNat
+    let real11 ← (registerValue? s 11).map BitVec.toNat
+    let real12 ← (registerValue? s 12).map BitVec.toNat
