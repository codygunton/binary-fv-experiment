+            | none => .gap ("MemoryBytes(after) and CodeIntact(after) hold;"
+                ++ " WritesOnlyWithinOwnAllocation(resultBase,848) is settled separately and"
+                ++ " record-independently by decoder_ownership_clauses_hold_at_every_record; the"
+                ++ " repRawV4 result clause needs a resultBase Row A does not pin, and postEntry's"
+                ++ " error arm admits ALL THREE SszDecodeError constructors so it is vacuous")
