+  let s ← captures[index]!.entryState
+  let row ← namedBindingRow? index "alloc"
+  let address ← bindingAddress? row s
+  let value ← bindingValue? row s
+  let x11 ← (registerValue? s 11).map BitVec.toNat
+  pure (address, value, x11)
