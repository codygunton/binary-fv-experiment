+        some "postAlloc.x10=address",
+        some "postAlloc.alignment≠0",
+        some "postAlloc.address%alignment=0",
+        some "postAlloc.WritesOnlyWithin(ownedRegion)",
+        some "postAlloc.cursor?(after)=some"] := by native_decide
