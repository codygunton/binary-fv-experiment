+/-- The five columns at the two copy rows, with the measured step counts. -/
+def copyRowVerdicts? : Array (Nat × String × Verdict × Verdict × Verdict × Verdict × Verdict ×
+    Option Nat × Option Nat) :=
+  #[139, 140].map fun index =>
+    let r := groundTruthRows[index]!
+    (r.index, r.routineTag, r.entered, r.pre, r.exited, r.post, r.steps, r.realSteps, r.stepBound)
+
+/-- **The two copy rows are decided on columns 1, 3, 4 and 5; column 2 is gated.** Their `post`
+cells are the only two passes in the harness.
