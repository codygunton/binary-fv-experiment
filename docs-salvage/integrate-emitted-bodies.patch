+/-- Overwrite `bytes` at `base` in a state. Used only to build counterfactual exit states. -/
+def writeBytes (s : State) (base : Nat) (bytes : ByteArray) : State :=
+  let mutated := (List.range bytes.size).foldl
+    (fun m index => m.insert (base + index) (BitVec.ofNat 8 (bytes[index]!).toNat)) s.mem
+  { s with mem := mutated }
