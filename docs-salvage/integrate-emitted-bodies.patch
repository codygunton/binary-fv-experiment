+/-- The three constant vtable thunks' mirrors, run on state pairs **borrowed from other instances**.
+
+Instances 5, 123 and 135 are never entered on this arm, so there is no state of theirs to run on and
+their rows stay capture gaps. These readings are therefore counterfactual exercises of the *checker*
+and say nothing whatever about those three instances — they exist so that three mirrors which the
+report never fires are not indistinguishable from mirrors that cannot fire. -/
+def constantThunkMirrorProbes? : Option (List (Option String)) := do
+  let allocBefore ← captures[0]!.entryState
+  let allocAfter ← captures[0]!.exitState
+  let quietBefore ← captures[136]!.entryState
+  let quietAfter ← captures[136]!.exitState
+  let zeroed : State := { quietAfter with regs := quietAfter.regs.insert x10 (BitVec.ofNat 64 0) }
+  pure [postAllocatorFreeFailure? canonicalEnvironment (.ok ()) allocBefore allocAfter,
+        postAllocatorFreeFailure? canonicalEnvironment (.ok ()) quietBefore quietAfter,
+        postAllocatorFreeFailure? canonicalEnvironment (.error SszDecodeError.invalidSsz)
