+theorem copy_post_check_flips_on_every_conjunct :
+    copyPostMutations? =
+      #[some (139, none,
+          some "postCopy.CodeIntact(after)",
+          some "postCopy.NoAllocation",
+          some "postCopy.WritesOnlyWithinOwnRecord(destination,length)",
+          some "postCopy.MemoryBytes(after,destination)",
+          some "postCopy.result=error(refutes)"),
+        some (140, none,
+          some "postCopy.CodeIntact(after)",
+          some "postCopy.NoAllocation",
+          some "postCopy.WritesOnlyWithinOwnRecord(destination,length)",
+          some "postCopy.MemoryBytes(after,destination)",
+          some "postCopy.result=error(refutes)")] := by native_decide
