+/-- The first failing conjunct of the copy contract's own `pre`, dispatched on which of the two it
+is. `memmove` genuinely has one conjunct fewer. -/
+def copyPreFailure? (family : CopyFamily) (args : CopyArgs) (s : State) : Option String :=
+  match family with
+  | .memcpy => preMemcpyFailure? canonicalEnvironment args s
+  | .memmove => preCopyFailure? canonicalEnvironment args s
