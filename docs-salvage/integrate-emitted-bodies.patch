+    allocCursorBlockMutations? =
+      some [none,
+        some "postAlloc.cursorBefore≤cursorAfter",
+        some "postAlloc.cursorDelta≤(alignment-1)+bytes",
+        some "postAlloc.cursorBefore≤address",
+        some "postAlloc.address+bytes≤cursorAfter",
+        some "postAlloc.WritesOnlyWithin(ownedRegion)"] := by native_decide
+
+/-- `postAlloc`'s failure arm at index 136: real, then with `x10` zeroed, then with the cursor word
+and an out-of-frame byte disturbed on top of that, then at a hand-made non-`outOfMemory` error. -/
+def index136PostErrorArmMutations? : Option (List (Option String)) := do
+  let before ← captures[136]!.entryState
+  let after ← captures[136]!.exitState
+  let args ← allocArgs? 136 before
+  let result := (contractAlloc canonicalEnvironment canonicalHeap).meaning args
+  let zeroed : State := { after with regs := after.regs.insert x10 (BitVec.ofNat 64 0) }
