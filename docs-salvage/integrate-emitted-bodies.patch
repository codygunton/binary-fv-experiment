+/-! ### `postAlloc`, mirrored in full
+
+Expanded, the success arm has **eleven** conjuncts and the failure arm four, and every one of them is
+evaluated below. The success arm is the only postcondition in the catalog with a non-empty allocation
+interval, and its `∃ cursorBefore cursorAfter` is not a real existential: `env.cursor?` is a
+function, so the two witnesses are determined by the two states, and a `none` from either reading
+refutes the arm outright. -/
+
+/-- The five conjuncts under `postAlloc`'s `∃ cursorBefore cursorAfter`, at the pair of cursor
+readings the two states determine. -/
+def allocCursorBlockB (args : AllocArgs) (address cursorBefore cursorAfter : Nat)
+    (before after : State) : Bool :=
+  decide (cursorBefore ≤ cursorAfter) &&
+    decide (cursorAfter - cursorBefore ≤ (args.alignment - 1) + args.bytes) &&
+    decide (cursorBefore ≤ address) &&
+    decide (address + args.bytes ≤ cursorAfter) &&
+    allocWritesOnlyWithinB cursorBefore cursorAfter before after
+
+def allocCursorBlockFailure? (args : AllocArgs) (address cursorBefore cursorAfter : Nat)
+    (before after : State) : Option String :=
+  if !decide (cursorBefore ≤ cursorAfter) then some "postAlloc.cursorBefore≤cursorAfter"
+  else if !decide (cursorAfter - cursorBefore ≤ (args.alignment - 1) + args.bytes) then
+    some "postAlloc.cursorDelta≤(alignment-1)+bytes"
+  else if !decide (cursorBefore ≤ address) then some "postAlloc.cursorBefore≤address"
+  else if !decide (address + args.bytes ≤ cursorAfter) then
+    some "postAlloc.address+bytes≤cursorAfter"
+  else if !allocWritesOnlyWithinB cursorBefore cursorAfter before after then
+    some "postAlloc.WritesOnlyWithin(ownedRegion)"
+  else none
+
+theorem allocCursorBlock_agrees (args : AllocArgs) (address cursorBefore cursorAfter : Nat)
+    (before after : State) :
+    (allocCursorBlockFailure? args address cursorBefore cursorAfter before after).isNone =
+      allocCursorBlockB args address cursorBefore cursorAfter before after := by
+  simp only [allocCursorBlockFailure?, allocCursorBlockB]
+  by_cases h1 : cursorBefore ≤ cursorAfter <;>
+    by_cases h2 : cursorAfter - cursorBefore ≤ (args.alignment - 1) + args.bytes <;>
+    by_cases h3 : cursorBefore ≤ address <;>
+    by_cases h4 : address + args.bytes ≤ cursorAfter <;>
+    by_cases h5 : allocWritesOnlyWithinB cursorBefore cursorAfter before after <;> simp_all
+
+/-- `postAlloc`'s success arm. The `∃ cursorBefore cursorAfter` is not a real existential: `cursor?`
+is a function of the state, so a `none` from either reading refutes the arm outright. -/
+def postAllocSuccessB (env : DecoderEnvironment) (args : AllocArgs) (address : Nat)
+    (before after : State) : Bool :=
+  decide (address ≠ 0) && decide (args.alignment ≠ 0) &&
+    decide (address % args.alignment = 0) &&
+    (after.regs.get? x10 == some (BitVec.ofNat 64 address)) &&
+    (match env.cursor? before, env.cursor? after with
+     | some cursorBefore, some cursorAfter =>
+         allocCursorBlockB args address cursorBefore cursorAfter before after
+     | _, _ => false)
+
+def postAllocSuccessFailure? (env : DecoderEnvironment) (args : AllocArgs) (address : Nat)
+    (before after : State) : Option String :=
+  if !decide (address ≠ 0) then some "postAlloc.address≠0"
+  else if !decide (args.alignment ≠ 0) then some "postAlloc.alignment≠0"
+  else if !decide (address % args.alignment = 0) then some "postAlloc.address%alignment=0"
+  else if after.regs.get? x10 != some (BitVec.ofNat 64 address) then some "postAlloc.x10=address"
+  else
+    match env.cursor? before, env.cursor? after with
+    | some cursorBefore, some cursorAfter =>
+        allocCursorBlockFailure? args address cursorBefore cursorAfter before after
+    | none, _ => some "postAlloc.cursor?(before)=some"
+    | _, none => some "postAlloc.cursor?(after)=some"
+
+theorem postAllocSuccess_agrees (env : DecoderEnvironment) (args : AllocArgs) (address : Nat)
+    (before after : State) :
+    (postAllocSuccessFailure? env args address before after).isNone =
+      postAllocSuccessB env args address before after := by
+  simp only [postAllocSuccessFailure?, postAllocSuccessB, ← allocCursorBlock_agrees]
+  by_cases h1 : address ≠ 0 <;> by_cases h2 : args.alignment ≠ 0 <;>
+    by_cases h3 : address % args.alignment = 0 <;>
+    by_cases h4 : after.regs.get? x10 = some (BitVec.ofNat 64 address) <;>
+    cases hb : env.cursor? before <;> cases ha : env.cursor? after <;> simp_all
