+theorem postAllocError_agrees (error : SszDecodeError) (before after : State) :
+    (postAllocErrorFailure? error before after).isNone = postAllocErrorB error before after := by
+  simp only [postAllocErrorFailure?, postAllocErrorB]
+  by_cases h1 : error = SszDecodeError.outOfMemory <;>
+    by_cases h2 : after.regs.get? x10 = some (BitVec.ofNat 64 0) <;>
+    by_cases h3 : noAllocationB before after <;>
+    by_cases h4 : scalarWritesOnlyWithinB before after <;> simp_all
+
+def postAllocCheckedB (env : DecoderEnvironment) (args : AllocArgs)
+    (result : Except SszDecodeError Nat) (before after : State) : Bool :=
+  codeIntactB env.image after &&
+    (match result with
+     | .ok address => postAllocSuccessB env args address before after
+     | .error error => postAllocErrorB error before after)
+
+/-- **The executable mirror is implied by the real postcondition**, at the canonical environment.
+Every expanded conjunct of both arms is evaluated, including the exact universal write frame at the
+allocator's own owned region. -/
+theorem postAllocCheckedB_of_postAlloc {args : AllocArgs}
+    {result : Except SszDecodeError Nat} {before after : State}
+    (h : postAlloc canonicalEnvironment args result before after) :
+    postAllocCheckedB canonicalEnvironment args result before after = true := by
+  obtain ⟨hcode, harm⟩ := h
+  simp only [postAllocCheckedB, Bool.and_eq_true]
+  refine ⟨codeIntactB_of_fileBytesMatchMemory hcode, ?_⟩
+  cases result with
+  | ok address =>
+      obtain ⟨hne, halign, hmod, hx10, cursorBefore, cursorAfter, hcb, hca, hle, hdelta, hlo, hhi,
+        hwrites⟩ := harm
+      have hw : allocWritesOnlyWithinB cursorBefore cursorAfter before after = true :=
+        (allocWritesOnlyWithinB_iff cursorBefore cursorAfter before after).mpr hwrites
+      simp only [postAllocSuccessB, allocCursorBlockB, hcb, hca, Bool.and_eq_true,
+        decide_eq_true_eq, beq_iff_eq]
+      exact ⟨⟨⟨⟨hne, halign⟩, hmod⟩, hx10⟩, ⟨⟨⟨hle, hdelta⟩, hlo⟩, hhi⟩, hw⟩
+  | error error =>
+      obtain ⟨herror, hx10, hnoalloc, hwrites⟩ := harm
+      simp only [postAllocErrorB, Bool.and_eq_true, beq_iff_eq]
+      exact ⟨⟨⟨herror, hx10⟩, noAllocationB_of_noAllocation hnoalloc⟩,
+        (scalarWritesOnlyWithinB_iff before after).mpr hwrites⟩
+
+/-- The first checked `postAlloc` conjunct that fails, by name. -/
+def postAllocFailure? (env : DecoderEnvironment) (args : AllocArgs)
+    (result : Except SszDecodeError Nat) (before after : State) : Option String :=
+  if !codeIntactB env.image after then some "postAlloc.CodeIntact(after)"
+  else
+    match result with
+    | .ok address => postAllocSuccessFailure? env args address before after
+    | .error error => postAllocErrorFailure? error before after
+
+theorem postAlloc_failing_conjunct_agrees_with_mirror (env : DecoderEnvironment)
+    (args : AllocArgs) (result : Except SszDecodeError Nat) (before after : State) :
+    (postAllocFailure? env args result before after).isNone =
+      postAllocCheckedB env args result before after := by
+  simp only [postAllocFailure?, postAllocCheckedB, ← postAllocSuccess_agrees,
+    ← postAllocError_agrees]
+  cases result <;> by_cases hcode : codeIntactB env.image after <;> simp_all
+
+/-! ### The three constant vtable thunks' postconditions, mirrored in full
+
+`allocatorResize` returns `false`, `allocatorRemap` returns null, `allocatorFree` is a no-op. Each
+postcondition has one conjunct that is **true by construction here** — `result = .ok false` /
+`= .ok 0` / `= .ok ()` — because the harness supplies `result` as the contract's own `meaning`, which
+is exactly that constant. It is evaluated anyway so the mirror covers the whole predicate, and named
+in the docstring so it is not read as machine evidence. -/
+
+def postAllocatorResizeCheckedB (env : DecoderEnvironment)
+    (result : Except SszDecodeError Bool) (before after : State) : Bool :=
+  codeIntactB env.image after && noAllocationB before after &&
+    (match result with | .ok value => value == false | .error _ => false) &&
+    (after.regs.get? x10 == some (BitVec.ofNat 64 0))
+
+theorem postAllocatorResizeCheckedB_of_post {result : Except SszDecodeError Bool}
+    {before after : State}
+    (h : (contractAllocatorResize canonicalEnvironment).post () result before after) :
+    postAllocatorResizeCheckedB canonicalEnvironment result before after = true := by
+  obtain ⟨hcode, hnoalloc, hresult, hx10⟩ := h
+  subst hresult
+  have hc := codeIntactB_of_fileBytesMatchMemory hcode
+  have hn := noAllocationB_of_noAllocation hnoalloc
+  simp [postAllocatorResizeCheckedB, hc, hn, hx10]
+
+def postAllocatorResizeFailure? (env : DecoderEnvironment)
+    (result : Except SszDecodeError Bool) (before after : State) : Option String :=
+  if !codeIntactB env.image after then some "postAllocatorResize.CodeIntact(after)"
+  else if !noAllocationB before after then some "postAllocatorResize.NoAllocation"
+  else if !(match result with | .ok value => value == false | .error _ => false) then
+    some "postAllocatorResize.result=ok false"
+  else if after.regs.get? x10 != some (BitVec.ofNat 64 0) then some "postAllocatorResize.x10=0"
+  else none
+
+theorem postAllocatorResize_failing_conjunct_agrees_with_mirror (env : DecoderEnvironment)
+    (result : Except SszDecodeError Bool) (before after : State) :
+    (postAllocatorResizeFailure? env result before after).isNone =
+      postAllocatorResizeCheckedB env result before after := by
+  simp only [postAllocatorResizeFailure?, postAllocatorResizeCheckedB]
+  by_cases h1 : codeIntactB env.image after <;>
+    by_cases h2 : noAllocationB before after <;>
+    by_cases h3 : (match result with | .ok value => value == false | .error _ => false) = true <;>
+    by_cases h4 : after.regs.get? x10 = some (BitVec.ofNat 64 0) <;> simp_all
+
+def postAllocatorRemapCheckedB (env : DecoderEnvironment)
+    (result : Except SszDecodeError Nat) (before after : State) : Bool :=
+  codeIntactB env.image after && noAllocationB before after &&
+    (match result with | .ok address => address == 0 | .error _ => false) &&
+    (after.regs.get? x10 == some (BitVec.ofNat 64 0))
+
+theorem postAllocatorRemapCheckedB_of_post {result : Except SszDecodeError Nat}
+    {before after : State}
+    (h : (contractAllocatorRemap canonicalEnvironment).post () result before after) :
+    postAllocatorRemapCheckedB canonicalEnvironment result before after = true := by
+  obtain ⟨hcode, hnoalloc, hresult, hx10⟩ := h
+  subst hresult
+  have hc := codeIntactB_of_fileBytesMatchMemory hcode
+  have hn := noAllocationB_of_noAllocation hnoalloc
+  simp [postAllocatorRemapCheckedB, hc, hn, hx10]
+
+def postAllocatorRemapFailure? (env : DecoderEnvironment)
+    (result : Except SszDecodeError Nat) (before after : State) : Option String :=
+  if !codeIntactB env.image after then some "postAllocatorRemap.CodeIntact(after)"
+  else if !noAllocationB before after then some "postAllocatorRemap.NoAllocation"
+  else if !(match result with | .ok address => address == 0 | .error _ => false) then
+    some "postAllocatorRemap.result=ok 0"
+  else if after.regs.get? x10 != some (BitVec.ofNat 64 0) then some "postAllocatorRemap.x10=0"
+  else none
+
+theorem postAllocatorRemap_failing_conjunct_agrees_with_mirror (env : DecoderEnvironment)
+    (result : Except SszDecodeError Nat) (before after : State) :
+    (postAllocatorRemapFailure? env result before after).isNone =
+      postAllocatorRemapCheckedB env result before after := by
+  simp only [postAllocatorRemapFailure?, postAllocatorRemapCheckedB]
+  by_cases h1 : codeIntactB env.image after <;>
+    by_cases h2 : noAllocationB before after <;>
+    by_cases h3 : (match result with | .ok address => address == 0 | .error _ => false) = true <;>
+    by_cases h4 : after.regs.get? x10 = some (BitVec.ofNat 64 0) <;> simp_all
+
+def postAllocatorFreeCheckedB (env : DecoderEnvironment)
+    (result : Except SszDecodeError Unit) (before after : State) : Bool :=
+  codeIntactB env.image after && noAllocationB before after &&
+    scalarWritesOnlyWithinB before after &&
+    (match result with | .ok _ => true | .error _ => false)
+
+theorem postAllocatorFreeCheckedB_of_post {result : Except SszDecodeError Unit}
+    {before after : State}
+    (h : (contractAllocatorFree canonicalEnvironment).post () result before after) :
+    postAllocatorFreeCheckedB canonicalEnvironment result before after = true := by
+  obtain ⟨hcode, hnoalloc, hwrites, hresult⟩ := h
+  subst hresult
+  have hc := codeIntactB_of_fileBytesMatchMemory hcode
+  have hn := noAllocationB_of_noAllocation hnoalloc
+  have hw := (scalarWritesOnlyWithinB_iff before after).mpr hwrites
+  simp [postAllocatorFreeCheckedB, hc, hn, hw]
+
+def postAllocatorFreeFailure? (env : DecoderEnvironment)
+    (result : Except SszDecodeError Unit) (before after : State) : Option String :=
+  if !codeIntactB env.image after then some "postAllocatorFree.CodeIntact(after)"
+  else if !noAllocationB before after then some "postAllocatorFree.NoAllocation"
+  else if !scalarWritesOnlyWithinB before after then
+    some "postAllocatorFree.WritesOnlyWithinOwnRecord"
+  else if !(match result with | .ok _ => true | .error _ => false) then
+    some "postAllocatorFree.result=ok ()"
+  else none
+
+theorem postAllocatorFree_failing_conjunct_agrees_with_mirror (env : DecoderEnvironment)
+    (result : Except SszDecodeError Unit) (before after : State) :
+    (postAllocatorFreeFailure? env result before after).isNone =
+      postAllocatorFreeCheckedB env result before after := by
+  simp only [postAllocatorFreeFailure?, postAllocatorFreeCheckedB]
+  by_cases h1 : codeIntactB env.image after <;>
+    by_cases h2 : noAllocationB before after <;>
+    by_cases h3 : scalarWritesOnlyWithinB before after <;>
+    by_cases h4 : (match result with | .ok _ => true | .error _ => false) = true <;> simp_all
+
+/-! ## `preCopy` / `postCopy`, mirrored in full — the copy family
+
+`memcpy` (index 139) and `memmove` (index 140) are the only two `copy`-family instances, and both
+are `kind := "emitted"`: real call boundaries with a real `jal`/`jalr` reaching them. That is the
+whole reason they are worth wiring. `preCopy` is a **register-based** precondition (`x10`/`x11`/`x12`
+= the RISC-V C ABI's `a0`/`a1`/`a2`), and a register-based precondition is only a meaningful question
+where the ABI actually applies. On the 127 `kind := "inlined"` instances there is no call, so the
+compiler was free to keep the values anywhere; on these two there is one.
+
+**The ownership clause here is not the leaf readers'.** `postCopy` carries
+`WritesOnlyWithinOwnRecord args.destination args.length`, a *non-empty* record, so
+`scalarWritesOnlyWithinB` (hard-wired to `0 0`) cannot be reused. `copyOwnedB` below is the same
+region at an arbitrary record, and `writesOnlyWithinB_iff` — which is already record-generic — ties
+it to the predicate exactly as it does for the scalar case. -/
+
+/-- The executable region a **non-allocating routine with a real result record** owns: its record,
+plus the canonical stack its frame lives in. `scalarReaderOwnedB` is this at `0 0`. -/
+def copyOwnedB (recordBase recordSize : Nat) (address : Nat) : Bool :=
+  decide (recordBase ≤ address ∧ address < recordBase + recordSize) ||
+    decide (Entrypoints.ZesuDecodeRaw.canonicalRunnerLayout.stackBase ≤ address ∧
+      address < Entrypoints.ZesuDecodeRaw.canonicalRunnerLayout.stackBase +
+        Entrypoints.ZesuDecodeRaw.canonicalRunnerLayout.stackSize)
+
+theorem copyOwnedB_iff (recordBase recordSize : Nat) (address : Nat) :
+    copyOwnedB recordBase recordSize address = true ↔
+      (Region.union (allocatedRegion recordBase recordSize 0 0) canonicalEnvironment.stack)
+        address := by
+  simp [copyOwnedB, canonicalEnvironment, canonicalStack, Region.union, allocatedRegion,
+    range, interval]
+
+/-- Exact executable form of a copy's ownership conjunct, at its real destination record. -/
+def copyWritesOnlyWithinB (recordBase recordSize : Nat) (before after : State) : Bool :=
+  writesOnlyWithinB (copyOwnedB recordBase recordSize) before after
+
+theorem copyWritesOnlyWithinB_iff (recordBase recordSize : Nat) (before after : State) :
+    copyWritesOnlyWithinB recordBase recordSize before after = true ↔
+      canonicalEnvironment.WritesOnlyWithinOwnRecord recordBase recordSize before after :=
+  writesOnlyWithinB_iff (copyOwnedB_iff recordBase recordSize) before after
+
+/-- All six `preCopy` conjuncts. Three of them (`MemoryBytes`, `contents.size` and, once Row A's
+binding register agrees with the one the contract names, each register clause) are true by
+construction at the arguments this harness can build — see `copyArgs?` and
+`copy_pre_conjuncts_true_by_construction`. The mirror still evaluates them, because a mirror that
+silently drops a conjunct is exactly the drift the agreement theorems exist to prevent. -/
+def preCopyB (env : DecoderEnvironment) (args : CopyArgs) (s : State) : Bool :=
+  memoryBytesB s args.source args.contents &&
+    (args.contents.size == args.length) &&
+    codeIntactB env.image s &&
+    (s.regs.get? x10 == some (BitVec.ofNat 64 args.destination)) &&
+    (s.regs.get? x11 == some (BitVec.ofNat 64 args.source)) &&
+    (s.regs.get? x12 == some (BitVec.ofNat 64 args.length))
+
+theorem preCopyB_of_preCopy {env : DecoderEnvironment} {args : CopyArgs} {s : State}
+    (h : preCopy env args s) : preCopyB env args s = true := by
+  obtain ⟨hmem, hsize, hcode, h10, h11, h12⟩ := h
+  simp only [preCopyB, Bool.and_eq_true, beq_iff_eq]
+  exact ⟨⟨⟨⟨⟨memoryBytesB_of_memoryBytes hmem, hsize⟩,
+    codeIntactB_of_fileBytesMatchMemory hcode⟩, h10⟩, h11⟩, h12⟩
+
+/-- **`memcpy`'s extra precondition disjunct**: the destination and source blocks do not overlap.
+
+This is the one conjunct of the whole copy precondition that is *not* made true by how the harness
+builds its arguments — it is a pure arithmetic fact about three numbers the machine itself put in
+`a0`/`a1`/`a2`, and either disjunct can be false. `memmove` deliberately does not carry it, which is
+the only difference between the two contracts' `pre`. -/
+def copyNonOverlapB (args : CopyArgs) : Bool :=
+  decide (args.destination + args.length ≤ args.source) ||
+    decide (args.source + args.length ≤ args.destination)
+
+/-- `memcpy`'s full precondition: `preCopy` and non-overlap. -/
+def preMemcpyB (env : DecoderEnvironment) (args : CopyArgs) (s : State) : Bool :=
+  preCopyB env args s && copyNonOverlapB args
+
+theorem preMemcpyB_of_pre {args : CopyArgs} {s : State}
+    (h : (contractMemcpy canonicalEnvironment).pre args s) :
+    preMemcpyB canonicalEnvironment args s = true := by
+  obtain ⟨hpre, hdisjoint⟩ := h
+  simp only [preMemcpyB, copyNonOverlapB, Bool.and_eq_true, Bool.or_eq_true, decide_eq_true_eq]
+  exact ⟨preCopyB_of_preCopy hpre, hdisjoint⟩
+
+theorem preCopyB_of_memmove_pre {args : CopyArgs} {s : State}
+    (h : (contractMemmove canonicalEnvironment).pre args s) :
+    preCopyB canonicalEnvironment args s = true :=
+  preCopyB_of_preCopy h
+
+/-- The first `preCopy` conjunct that fails, by name. -/
+def preCopyFailure? (env : DecoderEnvironment) (args : CopyArgs) (s : State) : Option String :=
+  if !memoryBytesB s args.source args.contents then some "preCopy.MemoryBytes(source)"
+  else if args.contents.size != args.length then some "preCopy.contents.size=length"
+  else if !codeIntactB env.image s then some "preCopy.CodeIntact"
+  else if s.regs.get? x10 != some (BitVec.ofNat 64 args.destination) then
+    some "preCopy.x10=destination"
+  else if s.regs.get? x11 != some (BitVec.ofNat 64 args.source) then some "preCopy.x11=source"
+  else if s.regs.get? x12 != some (BitVec.ofNat 64 args.length) then some "preCopy.x12=length"
+  else none
+
+theorem preCopy_failing_conjunct_agrees_with_mirror (env : DecoderEnvironment)
+    (args : CopyArgs) (s : State) :
+    (preCopyFailure? env args s).isNone = preCopyB env args s := by
+  simp only [preCopyFailure?, preCopyB]
+  by_cases h1 : memoryBytesB s args.source args.contents <;>
+    by_cases h2 : args.contents.size = args.length <;>
+    by_cases h3 : codeIntactB env.image s <;>
+    by_cases h4 : s.regs.get? x10 = some (BitVec.ofNat 64 args.destination) <;>
+    by_cases h5 : s.regs.get? x11 = some (BitVec.ofNat 64 args.source) <;>
+    by_cases h6 : s.regs.get? x12 = some (BitVec.ofNat 64 args.length) <;>
+    simp_all
+
+/-- The first `memcpy` precondition conjunct that fails, by name. The non-overlap disjunct is checked
+**last**, so a name of `memcpy.pre.nonOverlap` means every `preCopy` conjunct held and the two blocks
+genuinely overlap. -/
+def preMemcpyFailure? (env : DecoderEnvironment) (args : CopyArgs) (s : State) : Option String :=
+  match preCopyFailure? env args s with
+  | some clause => some clause
+  | none => if !copyNonOverlapB args then some "memcpy.pre.nonOverlap" else none
+
+theorem preMemcpy_failing_conjunct_agrees_with_mirror (env : DecoderEnvironment)
+    (args : CopyArgs) (s : State) :
+    (preMemcpyFailure? env args s).isNone = preMemcpyB env args s := by
+  simp only [preMemcpyFailure?, preMemcpyB, ← preCopy_failing_conjunct_agrees_with_mirror]
+  cases preCopyFailure? env args s with
+  | some clause => simp
+  | none => by_cases h : copyNonOverlapB args <;> simp_all
+
+/-- All four `postCopy` conjuncts.
+
+The `.error` arm of `postCopy` is `False`, not a weaker obligation, so the mirror returns `false`
+there rather than `true`: an error outcome refutes the postcondition outright. Both copy contracts'
+`meaning` is total (`.ok (meaningCopy args.contents)`), so that arm is unreachable at the real
+meaning — it is exercised directly by `copy_post_error_arm_is_refuting`. -/
+def postCopyCheckedB (env : DecoderEnvironment) (args : CopyArgs)
+    (result : Except SszDecodeError ByteArray) (before after : State) : Bool :=
+  codeIntactB env.image after &&
+    noAllocationB before after &&
+    copyWritesOnlyWithinB args.destination args.length before after &&
+    (match result with
+     | .ok contents => memoryBytesB after args.destination contents
+     | .error _ => false)
+
+theorem postCopyCheckedB_of_postCopy {args : CopyArgs}
+    {result : Except SszDecodeError ByteArray} {before after : State}
+    (h : postCopy canonicalEnvironment args result before after) :
+    postCopyCheckedB canonicalEnvironment args result before after = true := by
+  obtain ⟨hcode, hnoalloc, hwrites, harm⟩ := h
+  simp only [postCopyCheckedB, Bool.and_eq_true]
+  refine ⟨⟨⟨codeIntactB_of_fileBytesMatchMemory hcode, noAllocationB_of_noAllocation hnoalloc⟩,
+    (copyWritesOnlyWithinB_iff args.destination args.length before after).mpr hwrites⟩, ?_⟩
+  cases result with
+  | ok contents => exact memoryBytesB_of_memoryBytes harm
+  | error error => exact absurd harm not_false
+
+/-- The first `postCopy` conjunct that fails, by name. -/
+def postCopyFailure? (env : DecoderEnvironment) (args : CopyArgs)
+    (result : Except SszDecodeError ByteArray) (before after : State) : Option String :=
+  if !codeIntactB env.image after then some "postCopy.CodeIntact(after)"
+  else if !noAllocationB before after then some "postCopy.NoAllocation"
+  else if !copyWritesOnlyWithinB args.destination args.length before after then
+    some "postCopy.WritesOnlyWithinOwnRecord(destination,length)"
+  else
+    match result with
+    | .ok contents =>
+        if !memoryBytesB after args.destination contents then
+          some "postCopy.MemoryBytes(after,destination)"
+        else none
+    | .error _ => some "postCopy.result=error(refutes)"
+
+theorem postCopy_failing_conjunct_agrees_with_mirror (env : DecoderEnvironment)
+    (args : CopyArgs) (result : Except SszDecodeError ByteArray) (before after : State) :
+    (postCopyFailure? env args result before after).isNone =
+      postCopyCheckedB env args result before after := by
+  simp only [postCopyFailure?, postCopyCheckedB]
+  by_cases h1 : codeIntactB env.image after <;>
+    by_cases h2 : noAllocationB before after <;>
+    by_cases h3 : copyWritesOnlyWithinB args.destination args.length before after <;>
+    cases result with
+    | error error => simp_all
+    | ok contents =>
+        by_cases h4 : memoryBytesB after args.destination contents <;> simp_all
+
+/-! # The results family — `zesu_raw_error` and `zesu_raw_result`
+
+The two exported result accessors, and the only rows in this harness where the RISC-V calling
+convention is a meaningful question, because they are the only *emitted* routines wired in: they are
+really called, so a register discipline at their boundary means something. See the module docstring
+for why that convention nevertheless says nothing about their **arguments**.
+
+Everything below is the same four pieces the read family uses — dispatch, argument reconstruction,
+failure mirror, agreement theorem — at a different argument shape. -/
+
+/-! ## Decidable equality for the register payload types `platformPreserved` names
+
+`Agree platformPreserved` is an equality at eighteen registers whose Sail payload types are `BitVec`,
+`Vector`, `Option`, two enums and a list of structures. The generated model derives `BEq` for the
+last three but not `DecidableEq`, so the executable comparison would have had to rest on an unproved
+`BEq` reflexivity. Deriving the real `DecidableEq` instead keeps every one of the eighteen clauses a
+`decide` of the *equality the contract states*, with nothing weakened along the way. -/
+
+deriving instance DecidableEq for Privilege
+deriving instance DecidableEq for WaitReason
+deriving instance DecidableEq for HartState
+deriving instance DecidableEq for MemoryRegionType
+deriving instance DecidableEq for misaligned_exception
+deriving instance DecidableEq for PMAMisalignedExceptions
+deriving instance DecidableEq for AtomicSupport
+deriving instance DecidableEq for Reservability
+deriving instance DecidableEq for PMA
+deriving instance DecidableEq for PMA_Region
+
+/-! ## Observing the decoder globals
+
+The accessors' arguments live in memory, not in registers, so these are the observers the harness
+needs. Each returns `none` rather than a guess when the bytes do not encode anything a
+`DecoderGlobalsModel` could hold — and a `none` there is a *refutation at every model*, not a gap. -/
+
+def observeByte? (s : State) (address : Nat) : Option Nat :=
+  (s.mem.get? address).map BitVec.toNat
+
+/-- A one-byte `0`/`1` flag, read back as the `Bool` it encodes. Any other byte, or an unmapped
+address, is `none`: `FlagRep`/`OptionTagRep` pin the byte to `0` or `1` at *every* model, so anything
+else refutes them universally. -/
+def flagAt? (s : State) (address : Nat) : Option Bool :=
+  match observeByte? s address with
+  | some 0 => some false
+  | some 1 => some true
+  | _ => none
+
+theorem flagAt?_of_flagRep {s : State} {address : Nat} {value : Bool}
+    (h : FlagRep s address value) : flagAt? s address = some value := by
+  cases value <;> simp [flagAt?, observeByte?, FlagRep] at h ⊢ <;> simp [h]
+
+theorem flagAt?_of_optionTagRep {s : State} {address : Nat} {present : Bool}
+    (h : OptionTagRep s address present) : flagAt? s address = some present := by
+  cases present <;> simp [flagAt?, observeByte?, OptionTagRep] at h ⊢ <;> simp [h]
+
+/-- Bounded mirror of `Word32LERep`. -/
+def word32LERepB (s : State) (base value : Nat) : Bool :=
+  (List.range 4).all fun index =>
+    s.mem.get? (base + index) == some (BitVec.ofNat 8 ((value / 256 ^ index) % 256))
+
+theorem word32LERepB_of_word32LERep {s : State} {base value : Nat}
+    (h : Word32LERep s base value) : word32LERepB s base value = true := by
+  simp only [word32LERepB, List.all_eq_true, List.mem_range]
+  intro index hindex
+  simpa using h index hindex
+
+/-- The inverse of `DecodeStatus.code` on its image. A `last_status` word outside `{0,…,5}` is not a
+harness limitation: `Word32LERep state layout.status model.status.code` forces the word to be one of
+the six enum codes, so such a word refutes `pre` at every model. -/
+def decodeStatusOfCode? (code : Nat) : Option DecodeStatus :=
+  if code = 0 then some .notRun
+  else if code = 1 then some .ok
+  else if code = 2 then some .invalidSsz
+  else if code = 3 then some .unknownFork
+  else if code = 4 then some .outOfMemory
+  else if code = 5 then some .alreadyDecoded
+  else none
+
+theorem decodeStatusOfCode?_code (status : DecodeStatus) :
+    decodeStatusOfCode? status.code = some status := by
+  cases status <;> rfl
+
+/-- The `last_status` code the four globals bytes spell, when they spell one of the six enum codes.
+The low byte is taken as the candidate and the full four-byte representation is then *verified*, so
+the answer is unique by construction rather than by a search order. -/
+def statusCodeAt? (s : State) (base : Nat) : Option Nat := do
+  let low ← observeByte? s base
+  let _ ← decodeStatusOfCode? low
+  if word32LERepB s base low then some low else none
+
+theorem statusCodeAt?_of_word32LERep {s : State} {base : Nat} {status : DecodeStatus}
+    (h : Word32LERep s base status.code) : statusCodeAt? s base = some status.code := by
+  have hlow : s.mem.get? base = some (BitVec.ofNat 8 (status.code % 256)) := by
+    have := h 0 (by omega)
+    simpa using this
+  have hrep := word32LERepB_of_word32LERep h
+  cases status <;>
+    simp_all [statusCodeAt?, observeByte?, decodeStatusOfCode?, DecodeStatus.code]
+
+/-! ## The three ghost projections the accessor contracts actually read -/
+
+/-- What the two accessor contracts read out of a `DecoderGlobalsModel`, and nothing else. The
+`stored` *payload* is deliberately absent: it is an `SszBridge.RawV4`, it is not recoverable from the
+globals bytes, and `accessor_contracts_ignore_the_ghost_payload` proves nothing needs it. -/
+structure GlobalsObservation where
+  attempted : Bool
+  statusCode : Nat
+  storedPresent : Bool
+deriving DecidableEq, Repr, Inhabited
+
+/-- The three projections, read out of the pinned decoder globals in a captured state. -/
+def globalsObservation? (layout : DecoderGlobalsLayout) (s : State) : Option GlobalsObservation := do
+  let attempted ← flagAt? s layout.attempted
+  let statusCode ← statusCodeAt? s layout.status
+  let storedPresent ←
+    flagAt? s (layout.storedResult + layout.storedResultObject.discriminantOffset)
+  pure { attempted := attempted, statusCode := statusCode, storedPresent := storedPresent }
+
+/-- **The observation *is* the caller's model, whenever the state represents one at all.** This is
+what licenses evaluating `post` at the observation: the entry globals determine the three projections
+uniquely, and `accessor_contracts_ignore_the_ghost_payload` says the contracts read nothing else. So
+unlike the read family's `base`/`bytes`, this reconstruction is not a witness — it is the argument. -/
+theorem globalsObservation?_of_reps {layout : DecoderGlobalsLayout} {model : DecoderGlobalsModel}
+    {s : State} (hscalar : DecoderGlobalsScalarRep layout model s)
+    (hdisc : StoredResultDiscriminantRep layout model s) :
+    globalsObservation? layout s =
+      some { attempted := model.attempted, statusCode := model.status.code,
+             storedPresent := model.stored.isSome } := by
+  obtain ⟨hflag, hword⟩ := hscalar
+  simp [globalsObservation?, flagAt?_of_flagRep hflag, statusCodeAt?_of_word32LERep hword,
+    flagAt?_of_optionTagRep hdisc]
+
+/-- **Neither accessor contract reads the ghost `stored` payload.** Two models agreeing on
+`attempted`, `status` and `stored.isSome` have the same `pre`, the same `meaning` and the same `post`
+for both routines. This is what makes the un-materialisable `SszBridge.RawV4` a named non-argument
+rather than a hole: the harness is not approximating the model, it is supplying every field the
+contracts consult. -/
+theorem accessor_contracts_ignore_the_ghost_payload (env : DecoderEnvironment)
+    (layout : DecoderGlobalsLayout) (resultBuffer : Nat) (m n : DecoderGlobalsModel)
+    (ha : m.attempted = n.attempted) (hs : m.status = n.status)
+    (hp : m.stored.isSome = n.stored.isSome) :
+    (∀ s, (contractRawError env layout).pre m s ↔ (contractRawError env layout).pre n s) ∧
+    (contractRawError env layout).meaning m = (contractRawError env layout).meaning n ∧
+    (∀ result before after, postRawError env m result before after ↔
+      postRawError env n result before after) ∧
+    (∀ s, (contractRawResult env layout resultBuffer).pre m s ↔
+      (contractRawResult env layout resultBuffer).pre n s) ∧
+    (contractRawResult env layout resultBuffer).meaning m =
+      (contractRawResult env layout resultBuffer).meaning n ∧
+    (∀ result before after, postRawResult env resultBuffer m result before after ↔
+      postRawResult env resultBuffer n result before after) := by
+  refine ⟨?_, ?_, ?_, ?_, ?_, ?_⟩
+  · intro s; simp [contractRawError, DecoderGlobalsScalarRep, ha, hs]
+  · simp [contractRawError, hs]
+  · intro result before after
+    cases result <;> simp [postRawError, hs]
+  · intro s
+    simp [contractRawResult, StoredResultDiscriminantRep, OptionTagRep, hp]
+  · simp [contractRawResult, hp]
+  · intro result before after
+    cases result <;> simp [postRawResult, hp]
+
+/-! ## `preRawError` / `preRawResult`, mirrored **without** a witness model
+
+`contractRawError.pre` is `CodeIntact ∧ FlagRep(attempted) ∧ Word32LERep(last_status)`; the last two
+mention the ghost model, but only through a `Bool` and a code in `{0,…,5}`. So the disjunction over
+all models collapses to three questions about the state alone, and a `false` refutes `pre` at *every*
+model. That is the analogue of the read family's `x12 = offset` clause — a conjunct decidable without
+an argument the artifact fails to pin — except that here it is the *whole* precondition. -/
+
+def preRawErrorB (env : DecoderEnvironment) (layout : DecoderGlobalsLayout) (s : State) : Bool :=
+  codeIntactB env.image s &&
+    (flagAt? s layout.attempted).isSome &&
+    (statusCodeAt? s layout.status).isSome
+
+/-- **Implied by `pre` at every model**, so `preRawErrorB = false` refutes `contractRawError.pre`
+whatever ghost globals the caller names. -/
+theorem preRawErrorB_of_preRawError {env : DecoderEnvironment} {layout : DecoderGlobalsLayout}
+    {model : DecoderGlobalsModel} {s : State}
+    (h : (contractRawError env layout).pre model s) : preRawErrorB env layout s = true := by
+  obtain ⟨hcode, hflag, hword⟩ := h
+  simp [preRawErrorB, codeIntactB_of_fileBytesMatchMemory hcode, flagAt?_of_flagRep hflag,
+    statusCodeAt?_of_word32LERep hword]
+
+/-- The first `preRawError` conjunct that fails, by name. -/
+def preRawErrorFailure? (env : DecoderEnvironment) (layout : DecoderGlobalsLayout)
+    (s : State) : Option String :=
+  if !codeIntactB env.image s then some "preRawError.CodeIntact"
+  else if !(flagAt? s layout.attempted).isSome then some "preRawError.FlagRep(attempted)"
+  else if !(statusCodeAt? s layout.status).isSome then some "preRawError.Word32LERep(last_status)"
+  else none
+
+theorem preRawError_failing_conjunct_agrees_with_mirror (env : DecoderEnvironment)
+    (layout : DecoderGlobalsLayout) (s : State) :
+    (preRawErrorFailure? env layout s).isNone = preRawErrorB env layout s := by
+  simp only [preRawErrorFailure?, preRawErrorB]
+  by_cases h1 : codeIntactB env.image s <;>
+    by_cases h2 : (flagAt? s layout.attempted).isSome <;>
+    by_cases h3 : (statusCodeAt? s layout.status).isSome <;> simp_all
+
+def preRawResultB (env : DecoderEnvironment) (layout : DecoderGlobalsLayout) (s : State) : Bool :=
+  codeIntactB env.image s &&
+    (flagAt? s (layout.storedResult + layout.storedResultObject.discriminantOffset)).isSome
+
+theorem preRawResultB_of_preRawResult {env : DecoderEnvironment} {layout : DecoderGlobalsLayout}
+    {resultBuffer : Nat} {model : DecoderGlobalsModel} {s : State}
+    (h : (contractRawResult env layout resultBuffer).pre model s) :
+    preRawResultB env layout s = true := by
+  obtain ⟨hcode, hdisc⟩ := h
+  simp [preRawResultB, codeIntactB_of_fileBytesMatchMemory hcode, flagAt?_of_optionTagRep hdisc]
+
+/-- The first `preRawResult` conjunct that fails, by name. -/
+def preRawResultFailure? (env : DecoderEnvironment) (layout : DecoderGlobalsLayout)
+    (s : State) : Option String :=
+  if !codeIntactB env.image s then some "preRawResult.CodeIntact"
+  else if !(flagAt? s (layout.storedResult + layout.storedResultObject.discriminantOffset)).isSome
+    then some "preRawResult.StoredResultDiscriminantRep"
+  else none
+
+theorem preRawResult_failing_conjunct_agrees_with_mirror (env : DecoderEnvironment)
+    (layout : DecoderGlobalsLayout) (s : State) :
+    (preRawResultFailure? env layout s).isNone = preRawResultB env layout s := by
+  simp only [preRawResultFailure?, preRawResultB]
+  by_cases h1 : codeIntactB env.image s <;>
+    by_cases h2 :
+      (flagAt? s (layout.storedResult + layout.storedResultObject.discriminantOffset)).isSome <;>
+    simp_all
+
+/-! ## `Agree platformPreserved`, mirrored register by register
+
+**This is the ABI clause.** `x1` is the link register a callee owes its caller, and the other
+seventeen are the platform registers a single retiring `ret` reads. The list below is the *same data*
+the Boolean mirror and the failure-namer both consume, so the register a report blames cannot drift
+from the register the check compared. -/
+
+def platformPreservedChecks (before after : State) : List (String × Bool) :=
+  [ ("x1(ra)", decide (after.regs.get? x1 = before.regs.get? x1))
+  , ("hart_state", decide (after.regs.get? hart_state = before.regs.get? hart_state))
+  , ("cur_privilege", decide (after.regs.get? cur_privilege = before.regs.get? cur_privilege))
+  , ("satp", decide (after.regs.get? satp = before.regs.get? satp))
+  , ("mideleg", decide (after.regs.get? mideleg = before.regs.get? mideleg))
+  , ("mie", decide (after.regs.get? mie = before.regs.get? mie))
+  , ("mip", decide (after.regs.get? mip = before.regs.get? mip))
+  , ("pmpcfg_n", decide (after.regs.get? pmpcfg_n = before.regs.get? pmpcfg_n))
+  , ("pmpaddr_n", decide (after.regs.get? pmpaddr_n = before.regs.get? pmpaddr_n))
+  , ("mcountinhibit", decide (after.regs.get? mcountinhibit = before.regs.get? mcountinhibit))
+  , ("minstretcfg", decide (after.regs.get? minstretcfg = before.regs.get? minstretcfg))
+  , ("elp", decide (after.regs.get? elp = before.regs.get? elp))
+  , ("misa", decide (after.regs.get? misa = before.regs.get? misa))
+  , ("mstatus", decide (after.regs.get? mstatus = before.regs.get? mstatus))
+  , ("sig_meip", decide (after.regs.get? sig_meip = before.regs.get? sig_meip))
+  , ("pma_regions", decide (after.regs.get? pma_regions = before.regs.get? pma_regions))
+  , ("mseccfg", decide (after.regs.get? mseccfg = before.regs.get? mseccfg))
+  , ("htif_tohost_base",
+      decide (after.regs.get? htif_tohost_base = before.regs.get? htif_tohost_base)) ]
+
+def agreePlatformPreservedB (before after : State) : Bool :=
+  (platformPreservedChecks before after).all (fun check => check.2)
+
+def agreePlatformPreservedFailure? (before after : State) : Option String :=
+  ((platformPreservedChecks before after).find? fun check => !check.2).map
+    fun check => "Agree platformPreserved." ++ check.1
+
+private theorem find?_not_isNone_eq_all {α : Type} (p : α → Bool) (xs : List α) :
+    (xs.find? fun x => !p x).isNone = xs.all p := by
+  induction xs with
+  | nil => simp
+  | cons x xs ih => by_cases h : p x <;> simp [h, ih]
+
+theorem agreePlatformPreserved_failing_conjunct_agrees_with_mirror (before after : State) :
+    (agreePlatformPreservedFailure? before after).isNone =
+      agreePlatformPreservedB before after := by
+  simp only [agreePlatformPreservedFailure?, agreePlatformPreservedB, Option.isNone_map]
+  exact find?_not_isNone_eq_all _ _
+
+/-- **Implied by the real `Agree platformPreserved`**, at all eighteen registers. -/
+theorem agreePlatformPreservedB_of_agree {before after : State}
+    (h : Agree platformPreserved before after) :
+    agreePlatformPreservedB before after = true := by
+  simp only [agreePlatformPreservedB, platformPreservedChecks, List.all_cons, List.all_nil,
+    Bool.and_true, Bool.and_eq_true, decide_eq_true_eq]
+  refine ⟨h x1 (by simp [platformPreserved]), h hart_state (by simp [platformPreserved]),
+    h cur_privilege (by simp [platformPreserved]), h satp (by simp [platformPreserved]),
+    h mideleg (by simp [platformPreserved]), h mie (by simp [platformPreserved]),
+    h mip (by simp [platformPreserved]), h pmpcfg_n (by simp [platformPreserved]),
+    h pmpaddr_n (by simp [platformPreserved]), h mcountinhibit (by simp [platformPreserved]),
+    h minstretcfg (by simp [platformPreserved]), h elp (by simp [platformPreserved]),
+    h misa (by simp [platformPreserved]), h mstatus (by simp [platformPreserved]),
+    h sig_meip (by simp [platformPreserved]), h pma_regions (by simp [platformPreserved]),
+    h mseccfg (by simp [platformPreserved]), h htif_tohost_base (by simp [platformPreserved])⟩
+
+/-! ## The five frame conjuncts both accessor postconditions open with
+
+`postRawError` and `postRawResult` share `CodeIntact after ∧ NoAllocation ∧
+WritesOnlyWithinOwnRecord 0 0 ∧ Agree platformPreserved ∧ RetiredCounterPresent after`. The record is
+`0 0` — an accessor owns no result slot — which is exactly the record the scalar readers use, so
+`scalarWritesOnlyWithinB` decides the ownership clause here too, exactly. -/
+
+def retiredCounterPresentB (s : State) : Bool := (s.regs.get? minstret).isSome
+
+theorem retiredCounterPresentB_of_retiredCounterPresent {s : State}
+    (h : RetiredCounterPresent s) : retiredCounterPresentB s = true := by
+  obtain ⟨retired, hretired⟩ := h
+  simp [retiredCounterPresentB, hretired]
+
+def accessorFrameB (env : DecoderEnvironment) (before after : State) : Bool :=
+  codeIntactB env.image after && noAllocationB before after &&
+    scalarWritesOnlyWithinB before after && agreePlatformPreservedB before after &&
+    retiredCounterPresentB after
+
+/-- The first frame conjunct that fails, by name, prefixed with the routine it belongs to. -/
+def accessorFrameFailure? (env : DecoderEnvironment) (routine : String)
+    (before after : State) : Option String :=
+  if !codeIntactB env.image after then some (routine ++ ".CodeIntact(after)")
+  else if !noAllocationB before after then some (routine ++ ".NoAllocation")
+  else if !scalarWritesOnlyWithinB before after then
+    some (routine ++ ".WritesOnlyWithinOwnRecord")
+  else match agreePlatformPreservedFailure? before after with
+    | some clause => some (routine ++ "." ++ clause)
+    | none =>
+        if !retiredCounterPresentB after then some (routine ++ ".RetiredCounterPresent(after)")
+        else none
+
+theorem accessorFrame_failing_conjunct_agrees_with_mirror (env : DecoderEnvironment)
+    (routine : String) (before after : State) :
+    (accessorFrameFailure? env routine before after).isNone = accessorFrameB env before after := by
+  simp only [accessorFrameFailure?, accessorFrameB,
+    ← agreePlatformPreserved_failing_conjunct_agrees_with_mirror]
+  by_cases h1 : codeIntactB env.image after <;>
+    by_cases h2 : noAllocationB before after <;>
+    by_cases h3 : scalarWritesOnlyWithinB before after <;>
+    by_cases h5 : retiredCounterPresentB after <;>
+    cases h4 : agreePlatformPreservedFailure? before after <;> simp_all
+
+/-! ## `postRawError` / `postRawResult`, mirrored in full
+
+Seven conjuncts each: the five frame clauses, and two in the result arm. **The failure arm is
+`False`**, not "the error is `invalidSsz`" — these accessors cannot fail — so unlike the read family
+there is no trivially-satisfied error branch to gap out; an `.error` result is an outright
+refutation.
+
+One of the two result conjuncts is **vacuous in the obligation itself**, not merely in the harness:
+`postRawError` asks `code = model.status.code` of the value its own `meaning` produced, and
+`meaning model` *is* `.ok model.status.code`, so at the `result` the obligation supplies it is `rfl`.
+It is still evaluated (a different `result` would refute it — `accessor_result_arms_discriminate`
+exhibits that), but no verdict's force comes from it. The clause that carries the weight is
+`x10 = code`: the observation is read from the **entry** state's globals memory and `x10` from the
+**exit** state's registers, so nothing makes them agree by construction. -/
+
+def postRawErrorCheckedB (env : DecoderEnvironment) (statusCode : Nat)
+    (result : Except SszDecodeError Nat) (before after : State) : Bool :=
+  accessorFrameB env before after &&
+    (match result with
+     | .ok code => decide (code = statusCode) &&
+         (after.regs.get? x10 == some (BitVec.ofNat 64 code))
+     | .error _ => false)
+
+/-- **The executable mirror is implied by the real postcondition**, at the canonical environment and
+at the model the entry globals represent. Every expanded conjunct is evaluated. -/
+theorem postRawErrorCheckedB_of_postRawError {model : DecoderGlobalsModel}
+    {result : Except SszDecodeError Nat} {before after : State}
+    (h : postRawError canonicalEnvironment model result before after) :
+    postRawErrorCheckedB canonicalEnvironment model.status.code result before after = true := by
+  obtain ⟨hcode, hnoalloc, hwrites, hagree, hretired, harm⟩ := h
+  simp only [postRawErrorCheckedB, accessorFrameB, Bool.and_eq_true]
+  refine ⟨⟨⟨⟨⟨codeIntactB_of_fileBytesMatchMemory hcode, noAllocationB_of_noAllocation hnoalloc⟩,
+    (scalarWritesOnlyWithinB_iff before after).mpr hwrites⟩,
+    agreePlatformPreservedB_of_agree hagree⟩,
+    retiredCounterPresentB_of_retiredCounterPresent hretired⟩, ?_⟩
+  cases result with
+  | ok code =>
+      obtain ⟨heq, hx10⟩ := harm
+      simp only [Bool.and_eq_true, decide_eq_true_eq, beq_iff_eq]
+      exact ⟨heq, hx10⟩
+  | error error => exact absurd harm not_false
+
+/-- The first checked `postRawError` conjunct that fails, by name. -/
+def postRawErrorFailure? (env : DecoderEnvironment) (statusCode : Nat)
+    (result : Except SszDecodeError Nat) (before after : State) : Option String :=
+  match accessorFrameFailure? env "postRawError" before after with
+  | some clause => some clause
+  | none =>
+      match result with
+      | .ok code =>
+          if code != statusCode then some "postRawError.code=globals.last_status"
+          else if after.regs.get? x10 != some (BitVec.ofNat 64 code) then
+            some "postRawError.x10=code"
+          else none
+      | .error _ => some "postRawError.error-arm-is-False"
+
+theorem postRawError_failing_conjunct_agrees_with_mirror (env : DecoderEnvironment)
+    (statusCode : Nat) (result : Except SszDecodeError Nat) (before after : State) :
+    (postRawErrorFailure? env statusCode result before after).isNone =
+      postRawErrorCheckedB env statusCode result before after := by
+  simp only [postRawErrorFailure?, postRawErrorCheckedB,
+    ← accessorFrame_failing_conjunct_agrees_with_mirror (routine := "postRawError")]
+  cases accessorFrameFailure? env "postRawError" before after with
+  | some clause => simp
+  | none =>
+      cases result with
+      | ok code =>
+          by_cases h1 : code = statusCode <;>
+            by_cases h2 : after.regs.get? x10 = some (BitVec.ofNat 64 code) <;> simp_all
+      | error error => simp
+
+def postRawResultCheckedB (env : DecoderEnvironment) (resultBuffer : Nat) (storedPresent : Bool)
+    (result : Except SszDecodeError Nat) (before after : State) : Bool :=
+  accessorFrameB env before after &&
+    (match result with
+     | .ok pointer => decide (pointer = (if storedPresent then resultBuffer else 0)) &&
+         (after.regs.get? x10 == some (BitVec.ofNat 64 pointer))
+     | .error _ => false)
+
+theorem postRawResultCheckedB_of_postRawResult {resultBuffer : Nat} {model : DecoderGlobalsModel}
+    {result : Except SszDecodeError Nat} {before after : State}
+    (h : postRawResult canonicalEnvironment resultBuffer model result before after) :
+    postRawResultCheckedB canonicalEnvironment resultBuffer model.stored.isSome result
+      before after = true := by
+  obtain ⟨hcode, hnoalloc, hwrites, hagree, hretired, harm⟩ := h
+  simp only [postRawResultCheckedB, accessorFrameB, Bool.and_eq_true]
+  refine ⟨⟨⟨⟨⟨codeIntactB_of_fileBytesMatchMemory hcode, noAllocationB_of_noAllocation hnoalloc⟩,
+    (scalarWritesOnlyWithinB_iff before after).mpr hwrites⟩,
+    agreePlatformPreservedB_of_agree hagree⟩,
+    retiredCounterPresentB_of_retiredCounterPresent hretired⟩, ?_⟩
+  cases result with
+  | ok pointer =>
+      obtain ⟨heq, hx10⟩ := harm
+      simp only [Bool.and_eq_true, decide_eq_true_eq, beq_iff_eq]
+      exact ⟨heq, hx10⟩
+  | error error => exact absurd harm not_false
+
+/-- The first checked `postRawResult` conjunct that fails, by name. -/
+def postRawResultFailure? (env : DecoderEnvironment) (resultBuffer : Nat) (storedPresent : Bool)
+    (result : Except SszDecodeError Nat) (before after : State) : Option String :=
+  match accessorFrameFailure? env "postRawResult" before after with
+  | some clause => some clause
+  | none =>
+      match result with
+      | .ok pointer =>
+          if pointer != (if storedPresent then resultBuffer else 0) then
+            some "postRawResult.pointer=stored?resultBuffer:0"
+          else if after.regs.get? x10 != some (BitVec.ofNat 64 pointer) then
+            some "postRawResult.x10=pointer"
+          else none
+      | .error _ => some "postRawResult.error-arm-is-False"
+
+theorem postRawResult_failing_conjunct_agrees_with_mirror (env : DecoderEnvironment)
+    (resultBuffer : Nat) (storedPresent : Bool) (result : Except SszDecodeError Nat)
+    (before after : State) :
+    (postRawResultFailure? env resultBuffer storedPresent result before after).isNone =
+      postRawResultCheckedB env resultBuffer storedPresent result before after := by
+  simp only [postRawResultFailure?, postRawResultCheckedB,
+    ← accessorFrame_failing_conjunct_agrees_with_mirror (routine := "postRawResult")]
+  cases accessorFrameFailure? env "postRawResult" before after with
+  | some clause => simp
+  | none =>
+      cases result with
+      | ok pointer =>
+          by_cases h1 : pointer = (if storedPresent then resultBuffer else 0) <;>
+            by_cases h2 : after.regs.get? x10 = some (BitVec.ofNat 64 pointer) <;> simp_all
+      | error error => simp
+
+/-! ## Results-family dispatch and step bounds -/
+
+/-- The results-family tags, as the manifest spells them. An unrecognised tag is a gap, never a pass,
+exactly as for `ReadFamily`. -/
+inductive ResultsFamily where
+  | rawError | rawResult
+deriving DecidableEq, Repr, Inhabited
+
+def resultsFamily? (tagName : String) : Option ResultsFamily :=
+  if tagName = "rawError" then some .rawError
+  else if tagName = "rawResult" then some .rawResult
+  else none
+
+/-- The routine name a results-family clause is reported under. -/
+def resultsRoutineName : ResultsFamily → String
+  | .rawError => "postRawError"
+  | .rawResult => "postRawResult"
+
+/-- An arbitrary `DecoderGlobalsModel`, used only where the quantity computed is proved not to depend
+on it. `stored := none` is forced: `SszBridge.RawV4` has no `Inhabited` instance, which is precisely
+why the harness never fabricates a stored payload anywhere. -/
+def dummyGlobalsModel : DecoderGlobalsModel :=
+  { attempted := false, status := .notRun, stored := none }
+
+/-- The two accessors' own `stepBound`s, read off the real `FunctionContract` records. Evaluated at
+`dummyGlobalsModel`, which is sound because the bound does not depend on the model — proved
+immediately below rather than assumed. -/
+def resultsFamilyStepBound (results : ResultsFamily) : Nat :=
+  match results with
+  | .rawError =>
+      (contractRawError canonicalEnvironment Elfling.canonicalDecoderGlobalsLayout).stepBound
+        dummyGlobalsModel
+  | .rawResult =>
+      (contractRawResult canonicalEnvironment Elfling.canonicalDecoderGlobalsLayout
+        Elfling.canonicalResultBuffer).stepBound dummyGlobalsModel
+
+theorem results_family_stepBound_ignores_args (env : DecoderEnvironment)
+    (layout : DecoderGlobalsLayout) (resultBuffer : Nat) (m n : DecoderGlobalsModel) :
+    (contractRawError env layout).stepBound m = (contractRawError env layout).stepBound n ∧
+      (contractRawResult env layout resultBuffer).stepBound m =
+        (contractRawResult env layout resultBuffer).stepBound n :=
+  ⟨rfl, rfl⟩
+
+/-- **The `result` the harness feeds `post` is the contract's own `meaning`**, spelled at the
+observation rather than at a model the harness cannot build. Both are `rfl`, which is what makes the
+substitution legitimate rather than convenient. -/
+theorem rawError_meaning_is_the_status_code (env : DecoderEnvironment)
+    (layout : DecoderGlobalsLayout) (model : DecoderGlobalsModel) :
+    (contractRawError env layout).meaning model = .ok model.status.code := rfl
+
+theorem rawResult_meaning_is_the_payload_address (env : DecoderEnvironment)
+    (layout : DecoderGlobalsLayout) (resultBuffer : Nat) (model : DecoderGlobalsModel) :
+    (contractRawResult env layout resultBuffer).meaning model =
+      .ok (if model.stored.isSome then resultBuffer else 0) := rfl
