+def preservedInputAndCodeFailure? (label : String) (env : DecoderEnvironment) (base : Nat)
+    (bytes : ByteArray) (after : State) : Option String :=
+  if !memoryBytesB after base bytes then some (label ++ ".MemoryBytes(after)")
+  else if !codeIntactB env.image after then some (label ++ ".CodeIntact(after)")
+  else none
+
+theorem preservedInputAndCode_failing_conjunct_agrees_with_mirror (label : String)
+    (env : DecoderEnvironment) (base : Nat) (bytes : ByteArray) (after : State) :
+    (preservedInputAndCodeFailure? label env base bytes after).isNone =
+      preservedInputAndCodeB env base bytes after := by
+  simp only [preservedInputAndCodeFailure?, preservedInputAndCodeB]
+  by_cases h1 : memoryBytesB after base bytes <;>
+    by_cases h2 : codeIntactB env.image after <;> simp_all
+
+/-- **`postEntry`'s two evaluated conjuncts.** The ownership clause and the `repRawV4` result clause
+both mention `args.resultBase`, which Row A does not bind for `decodeRaw`. -/
+theorem preservedInputAndCodeB_of_postEntry {env : DecoderEnvironment} {args : EntryArgs}
+    {rep : ContainerRepresentation SszBridge.RawV4}
+    {result : Except SszDecodeError SszBridge.RawV4} {before after : State}
+    (h : postEntry env args rep result before after) :
+    preservedInputAndCodeB env args.base args.bytes after = true := by
+  obtain ⟨hmem, hcode, _, _⟩ := h
+  simp only [preservedInputAndCodeB, Bool.and_eq_true]
+  exact ⟨memoryBytesB_of_memoryBytes hmem, codeIntactB_of_fileBytesMatchMemory hcode⟩
