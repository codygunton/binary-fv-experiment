+def bumpX10 (s : State) : State :=
+  { s with regs := s.regs.insert x10 (((s.regs.get? x10).getD 0) + 1) }
+def bumpX11 (s : State) : State :=
+  { s with regs := s.regs.insert x11 (((s.regs.get? x11).getD 0) + 1) }
+def bumpX12 (s : State) : State :=
+  { s with regs := s.regs.insert x12 (((s.regs.get? x12).getD 0) + 1) }
+
+/-- `preMemcpyFailure?` at index 139 on the real entry state and on six counterfactuals, one per
+conjunct. The register bumps and byte flips mutate the STATE only, leaving the argument record built
+from the unmutated state, which is what lets each conjunct be reached in isolation. -/
+def copyPreMutations? : Option (Option String × Option String × Option String × Option String ×
+    Option String × Option String × Option String) := do
+  let s ← captures[139]!.entryState
+  let args ← copyArgs? 139 s
+  let truncated : CopyArgs := { args with contents := args.contents.extract 0 (args.contents.size - 1) }
+  pure (preMemcpyFailure? canonicalEnvironment args s,
+        preMemcpyFailure? canonicalEnvironment args (bumpX10 s),
+        preMemcpyFailure? canonicalEnvironment args (bumpX11 s),
+        preMemcpyFailure? canonicalEnvironment args (bumpX12 s),
+        preMemcpyFailure? canonicalEnvironment args (bumpByte s 81592),
+        preMemcpyFailure? canonicalEnvironment args (bumpByte s args.source),
+        preMemcpyFailure? canonicalEnvironment truncated s)
+
+/-- **Every `preCopy` conjunct fires, and the unmutated state fires none of them.** The `81592` flip
+is `memcpy`'s own first instruction byte in the file-backed text image, so it reaches
+`preCopy.CodeIntact`; the `args.source` flip reaches `preCopy.MemoryBytes(source)`; dropping one byte
+from the witnessed slice reaches `preCopy.contents.size=length`.
+
+The last two are the conjuncts this harness makes true by construction, and they are exercised here
+precisely because a conjunct that cannot fail is indistinguishable from one that is never checked.
+Their firing under mutation does **not** upgrade them to measurements — it only licenses reading
+`preCopyFailure? = none` as "the mirror ran" rather than "the mirror is inert". -/
