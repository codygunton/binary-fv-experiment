+  pure [allocCursorBlockFailure? real 86048 86048 86080 before after,
+        allocCursorBlockFailure? real 86048 86080 86048 before after,
+        allocCursorBlockFailure? { real with bytes := 0, alignment := 1 } 86048 86048 86080
+          before after,
+        allocCursorBlockFailure? real 86040 86048 86080 before after,
+        allocCursorBlockFailure? { real with bytes := 48, alignment := 64 } 86048 86048 86080
+          before after,
+        allocCursorBlockFailure? real 86048 86048 86080 before (bumpByte after 0)]
