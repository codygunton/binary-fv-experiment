+  let destinationRow ← bindingRow? index "dst"
+  let destination ← bindingValue? destinationRow s
+  let sourceRow ← bindingRow? index "src"
+  let source ← bindingValue? sourceRow s
+  let lengthRow ← bindingRow? index "n"
+  let length ← bindingValue? lengthRow s
+  let contents ← readSlice? s source length
+  pure { destination := destination, source := source, length := length, contents := contents }
