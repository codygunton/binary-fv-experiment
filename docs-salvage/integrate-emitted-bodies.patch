+    constantThunkMirrorProbes? =
+      some [some "postAllocatorFree.NoAllocation",
+        none,
+        some "postAllocatorFree.result=ok ()",
+        some "postAllocatorResize.x10=0",
+        none,
+        some "postAllocatorRemap.result=ok 0"] := by native_decide
+
+/-- `preCodeIntactFailure?` — the whole of the three constant thunks' precondition — on a borrowed
+entry state and on the same state with one code byte flipped. Same disclaimer as above: a checker
+probe, not a reading about instances 5, 123 or 135. -/
+def constantThunkPreProbes? : Option (Option String × Option String) := do
+  let entry ← captures[0]!.entryState
+  pure (preCodeIntactFailure? canonicalEnvironment entry,
+        preCodeIntactFailure? canonicalEnvironment (bumpByte entry 66124))
