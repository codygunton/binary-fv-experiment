+theorem accessor_result_arms_discriminate :
+    accessorResultArmMutations? =
+      some ((none,
+             some "postRawError.x10=code",
+             some "postRawError.code=globals.last_status",
+             some "postRawError.error-arm-is-False"),
+            (none,
+             some "postRawResult.x10=pointer",
+             some "postRawResult.pointer=stored?resultBuffer:0",
+             some "postRawResult.error-arm-is-False")) := by native_decide
