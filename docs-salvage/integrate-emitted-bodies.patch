+  if error != SszDecodeError.outOfMemory then some "postAlloc.error=outOfMemory"
+  else if after.regs.get? x10 != some (BitVec.ofNat 64 0) then some "postAlloc.x10=0"
+  else if !noAllocationB before after then some "postAlloc.NoAllocation"
+  else if !scalarWritesOnlyWithinB before after then some "postAlloc.WritesOnlyWithinOwnRecord"
