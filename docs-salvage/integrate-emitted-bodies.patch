+/-! ### Power test: every wired conjunct, shown going both ways
+
+The accessors are never entered, so there is no captured state *of theirs* to run the checkers on.
+The mutations below therefore run on a **real captured state that is not theirs**: the exit state of
+the whole `zesu_decode_raw` instance (index 1, retired step 39869), which is precisely the state a
+host is in when it calls `zesu_raw_error`/`zesu_raw_result`. Nothing here is a verdict about index
+137 or 138 — it is evidence that the checkers discriminate rather than being incapable of firing. -/
+
+/-- The state the accessor checkers are exercised on: the captured exit of `zesu_decode_raw`. -/
+def accessorProbeState? : Option State := captures[1]!.exitState
+
+/-- Set one byte of a state to an exact value (unlike `bumpByte`, which only perturbs). -/
+def setByte (s : State) (address value : Nat) : State :=
+  { s with mem := s.mem.insert address (BitVec.ofNat 8 value) }
+
+/-- The decoder globals as the harness reads them at the probe state. -/
+def accessorProbeObservation? : Option GlobalsObservation := do
+  let s ← accessorProbeState?
+  globalsObservation? Elfling.canonicalDecoderGlobalsLayout s
+
+/-- **The globals really are materialisable, and they say what the decode did.** At the wrapper's
+exit the `attempted` flag is set, `last_status` holds `1` (`DecodeStatus.ok`), and the inline
+`stored_result` discriminant is present. So the ghost model the accessors are contracted against is
+fully determined by real machine memory — the argument reconstruction is not hypothetical, only its
+*subject* (a call to the accessors) is missing from this arm. -/
+theorem accessor_probe_observation :
+    accessorProbeObservation? =
+      some { attempted := true, statusCode := 1, storedPresent := true } := by native_decide
+
+/-- `preRawErrorFailure?` / `preRawResultFailure?` at the probe state, then under one targeted byte
+mutation per conjunct. The three addresses are disjoint: the instance's own entry pc inside the
+file-backed image, the `attempted` flag, the low `last_status` byte, and the `stored_result`
+discriminant. -/
+def accessorPreMutations? : Option ((Option String × Option String × Option String × Option String) ×
+    (Option String × Option String × Option String)) := do
+  let s ← accessorProbeState?
+  let layout := Elfling.canonicalDecoderGlobalsLayout
+  let discriminant := layout.storedResult + layout.storedResultObject.discriminantOffset
+  let checkError := fun (t : State) => preRawErrorFailure? canonicalEnvironment layout t
+  let checkResult := fun (t : State) => preRawResultFailure? canonicalEnvironment layout t
+  pure ((checkError s,
+         checkError (bumpByte s 79744),
+         checkError (setByte s layout.attempted 7),
+         checkError (setByte s layout.status 9)),
+        (checkResult s,
+         checkResult (bumpByte s 79744),
+         checkResult (setByte s discriminant 3)))
+
+/-- **Both accessor preconditions are decidable, satisfiable, and refutable — on real machine data.**
+At the probe state neither mirror reports a failure, so `pre` is not a check that always fires. Each
+of its conjuncts is then exhibited firing under a one-byte mutation:
+
+* corrupting the accessor's own first instruction (`0x137c0`, file-backed) refutes `CodeIntact`;
+* writing `7` into the one-byte `attempted` flag refutes `FlagRep` — at **every** model, since
+  `FlagRep` pins that byte to `0` or `1` whatever the ghost `attempted` is;
+* writing `9` into the low `last_status` byte refutes `Word32LERep` for the same reason: `9` is not
+  in the image of `DecodeStatus.code`;
+* writing `3` into the `stored_result` discriminant refutes `StoredResultDiscriminantRep`.
+
+That is the whole of both preconditions, both directions, with no witness argument anywhere. -/
+theorem accessor_pre_checks_discriminate :
+    accessorPreMutations? =
+      some ((none,
+             some "preRawError.CodeIntact",
+             some "preRawError.FlagRep(attempted)",
+             some "preRawError.Word32LERep(last_status)"),
+            (none,
+             some "preRawResult.CodeIntact",
+             some "preRawResult.StoredResultDiscriminantRep")) := by native_decide
+
+/-- The eighteen `Agree platformPreserved` register comparisons, on two state pairs: a state against
+itself, and against the empty initial state. -/
+def platformPreservedCheckVectors? : Option (List Bool × List Bool) := do
+  let s ← accessorProbeState?
+  pure ((platformPreservedChecks s s).map (fun check => check.2),
+        (platformPreservedChecks s initialState).map (fun check => check.2))
+
+/-- **Every one of the eighteen ABI register clauses is exercised in both directions.** Against
+itself the probe state agrees at all eighteen; against the empty initial state — where every register
+is absent — it disagrees at all eighteen. So no clause in the list is a constant, including the
+fifteen that no individual mutation below touches. -/
+theorem platform_preserved_checks_each_go_both_ways :
+    platformPreservedCheckVectors? =
+      some (List.replicate 18 true, List.replicate 18 false) := by native_decide
+
+/-- The five shared frame conjuncts, on the probe state against itself and under one mutation each.
+`x1` is the link register — the clause that carries the actual RISC-V callee-saved obligation. -/
+def accessorFrameMutations? : Option (Option String × Option String × Option String × Option String ×
+    Option String × Option String) := do
+  let s ← accessorProbeState?
+  let check := fun (after : State) =>
+    accessorFrameFailure? canonicalEnvironment "postRawError" s after
+  pure (check s,
+        check (bumpByte s 79744),
+        check (bumpByte s Elfling.canonicalHeapPosAddr),
+        check (bumpByte s 0),
+        check { s with regs := s.regs.insert x1 (BitVec.ofNat 64 0) },
+        check { s with regs := s.regs.erase minstret })
