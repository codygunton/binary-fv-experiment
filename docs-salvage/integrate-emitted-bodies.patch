+         errorCheck 1 (.ok 1) (withX10 2),
+         errorCheck 1 (.ok 2) (withX10 2),
+         errorCheck 1 (.error .invalidSsz) (withX10 1)),
+        (resultCheck (.ok buffer) (withX10 buffer),
+         resultCheck (.ok buffer) (withX10 0),
+         resultCheck (.ok 0) (withX10 0),
+         resultCheck (.error .invalidSsz) (withX10 buffer)))
