+  let codeDestination := 81592
+  let codeArgs : CopyArgs := { args with destination := codeDestination }
+  let delivered : State := writeBytes after codeDestination args.contents
+  pure (postCopyFailure? canonicalEnvironment codeArgs (.ok codeArgs.contents) before after,
+        postCopyFailure? canonicalEnvironment codeArgs (.ok codeArgs.contents) before delivered,
+        codeIntactB canonicalEnvironment.image delivered,
+        memoryBytesB delivered codeDestination codeArgs.contents)
