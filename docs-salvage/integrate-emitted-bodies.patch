+set_option synthInstance.maxSize 400 in
+/-- **The five-conjunct accessor frame gate has teeth, one mutation per conjunct.** Unmutated it
+reports nothing; corrupting a text byte, the allocator cursor, an out-of-frame heap byte, the link
+register, or the retired-instruction counter each brings back exactly its own clause. The `x1` case
+is the one that matters most here: it is the RISC-V callee-saved discipline, and it is a clause the
+127 inlined rows could not meaningfully carry. -/
+theorem accessor_frame_gate_discriminates :
+    accessorFrameMutations? =
+      some (none,
+            some "postRawError.CodeIntact(after)",
+            some "postRawError.NoAllocation",
+            some "postRawError.WritesOnlyWithinOwnRecord",
+            some "postRawError.Agree platformPreserved.x1(ra)",
+            some "postRawError.RetiredCounterPresent(after)") := by native_decide
+
+/-- Both result arms of both accessor postconditions, on hand-built exit states. For each routine:
+the demanded `a0` present; `a0` moved off it; the `result` moved off the contract's own `meaning`;
+and an `.error` result, which `postRawError`/`postRawResult` forbid outright. -/
+def accessorResultArmMutations? :
+    Option ((Option String × Option String × Option String × Option String) ×
+      (Option String × Option String × Option String × Option String)) := do
+  let s ← accessorProbeState?
+  let buffer := Elfling.canonicalResultBuffer
+  let withX10 := fun (value : Nat) =>
+    ({ s with regs := s.regs.insert x10 (BitVec.ofNat 64 value) } : State)
+  let errorCheck := fun (code : Nat) (result : Except SszDecodeError Nat) (after : State) =>
+    postRawErrorFailure? canonicalEnvironment code result s after
+  let resultCheck := fun (result : Except SszDecodeError Nat) (after : State) =>
+    postRawResultFailure? canonicalEnvironment buffer true result s after
