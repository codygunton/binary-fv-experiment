+            | none => .gap ("MemoryBytes(after) and CodeIntact(after) hold;"
+                ++ " WritesOnlyWithinOwnAllocation(resultBase,16) is settled separately and"
+                ++ " record-independently by decoder_ownership_clauses_hold_at_every_record; the"
+                ++ " existential AllocatedDescriptorArray clause needs a resultBase Row A does not"
