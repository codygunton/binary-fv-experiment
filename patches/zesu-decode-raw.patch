 ///    [14..18] offset → public_keys (packed ByteVector[65])
-pub fn decode(alloc: std.mem.Allocator, data: []const u8) !input_mod.StatelessInput {
+pub fn decodeRaw(alloc: std.mem.Allocator, data: []const u8) !input_mod.StatelessInput {
     // Strip Ere's 4-byte LE length prefix when present. The first 4 bytes of
     // raw SSZ are always a small offset value, so matching against data.len-4
     // is unambiguous for any real payload.
@@ -305,10 +305,7 @@
 
     // transactions: List[ByteList, N] — offset-table format
     const txs_raw = try decodeByteListList(alloc, ep_data[off_transactions..off_withdrawals]);
-    const transactions = try alloc.alloc(input_mod.Transaction, txs_raw.len);
-    for (txs_raw, 0..) |raw_tx, i| {
-        transactions[i] = try rlp_decode.decodeSingleTx(alloc, raw_tx);
-    }
+    const transactions: []const input_mod.Transaction = &.{};
 
     // block_access_list: last variable field (V4 only; empty for V3 via sentinel offset).
     const block_access_list = try alloc.dupe(u8, ep_data[off_block_access_list..]);
@@ -397,3 +394,15 @@
         .public_keys = public_keys,
     };
 }
+
+/// Decode raw SSZ first, then retain production behavior by running the unchanged RLP conversion.
+pub fn decode(alloc: std.mem.Allocator, data: []const u8) !input_mod.StatelessInput {
+    var result = try decodeRaw(alloc, data);
+    const raw_transactions = result.new_payload_request.execution_payload.raw_transactions;
+    const transactions = try alloc.alloc(input_mod.Transaction, raw_transactions.len);
+    for (raw_transactions, 0..) |raw_tx, i| {
+        transactions[i] = try rlp_decode.decodeSingleTx(alloc, raw_tx);
+    }
+    result.new_payload_request.execution_payload.transactions = transactions;
+    return result;
+}
diff --git a/src/zkvm/raw_ssz_root.zig b/src/zkvm/raw_ssz_root.zig
new file mode 100644
--- /dev/null
+++ b/src/zkvm/raw_ssz_root.zig
@@ -0,0 +1,25 @@
+//! Narrow freestanding root for raw SSZ decoding only.
+const std = @import("std");
+const ssz_decode = @import("ssz_decode");
+const zesu_allocator = @import("zesu_allocator");
+
+pub fn panic(
+    msg: []const u8,
+    error_return_trace: ?*std.builtin.StackTrace,
+    ret_addr: ?usize,
+) noreturn {
+    _ = msg;
+    _ = error_return_trace;
+    _ = ret_addr;
+    while (true) {}
+}
+
+/// Return one for a successfully decoded raw SSZ input and zero for a decoder error.
+///
+/// The C harness owns input and allocator bounds. Retaining the parsed value forces all parser
+/// fields and allocations to be evaluated without importing RLP, execution, or cryptography.
+export fn zesu_decode_raw(input_ptr: [*]const u8, input_len: usize) i32 {
+    const allocator = zesu_allocator.get();
+    _ = ssz_decode.decodeRaw(allocator, input_ptr[0..input_len]) catch return 0;
+    return 1;
+}
