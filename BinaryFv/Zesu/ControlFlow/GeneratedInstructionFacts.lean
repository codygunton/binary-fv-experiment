/-- Every listed word is the little-endian file image at its address. Checked against
the pinned ELF, not assumed. -/
def instructionFactsMatchImage (image : BinaryFv.Binary.ProgramImage) : Bool :=
  provenInstructionWords.all fun entry =>
    image.readFileU32LE? entry.1 == some entry.2

theorem provenInstructionWords_match_image :
    instructionFactsMatchImage BinaryFv.Zesu.Artifacts.programImage = true := by
  native_decide

end BinaryFv.Zesu.MachineRegions
