import BinaryFv.Zesu.DecodedValue.Observers
import BinaryFv.RiscV.Platform.StoreMemoryWrite
import BinaryFv.RiscV.Logic.MemoryWriteFrame
import BinaryFv.RiscV.Logic.SepLogic
import LeanRV64DExecutable

/-!
# Machine representation of Zesu's decoded `StatelessInput`

These predicates mirror the same-ELF DWARF layout generated by
`zesuSszDecodeStatelessInputLayout`. They bind the semantic value used by the compliance relation
to concrete bytes and pointers at the optimized `ssz.decode`/`writeSuccess` boundary.
-/

namespace BinaryFv.Zesu

open PreSail

private def byteAt (value index : Nat) : BitVec 8 :=
  BitVec.ofNat 8 ((value / 2 ^ (8 * index)) % 256)

def UIntRep (width : Nat) (mem : Std.ExtHashMap Nat (BitVec 8))
    (address value : Nat) : Prop :=
  value < 2 ^ (8 * width) ∧ address + width ≤ 2 ^ 64 ∧
    ∀ index, index < width → mem.get? (address + index) = some (byteAt value index)

theorem UIntRep.of_mem_eq {width address value : Nat}
    {before after : Std.ExtHashMap Nat (BitVec 8)} (rep : UIntRep width before address value)
    (memory : after = before) : UIntRep width after address value := by
  simpa [memory] using rep

/-- Preserve an integer representation across writes proved disjoint from its byte window. -/
theorem UIntRep.of_writesOnlyWithin {width address value : Nat}
    {before after : BinaryFv.RiscV.State} {owned : BinaryFv.RiscV.Region}
    (rep : UIntRep width before.mem address value)
    (writes : BinaryFv.RiscV.WritesOnlyWithin owned before after)
    (outside : ∀ index, index < width → ¬ owned (address + index)) :
    UIntRep width after.mem address value := by
  refine ⟨rep.1, rep.2.1, ?_⟩
  intro index inBounds
  rw [writes (address + index) (outside index inBounds)]
  exact rep.2.2 index inBounds

/-- Expose a `UIntRep` byte window in the Sail little-endian form consumed by dword loads. -/
theorem UIntRep.leBytes {n address value : Nat} {mem : Std.ExtHashMap Nat (BitVec 8)}
    (rep : UIntRep n mem address value) (index : Nat) (bound : index < n) :
    mem.get? (address + index) =
      some (getElem (BinaryFv.RiscV.Sep.leBytes n (BitVec.ofNat (8 * n) value)) index (by
        simpa only [BinaryFv.RiscV.Sep.leBytes_length] using bound)) := by
  rw [rep.2.2 index bound]
  congr 1
  apply BitVec.eq_of_toNat_eq
  simp [byteAt, BinaryFv.RiscV.Sep.leBytes, Nat.shiftRight_eq_div_pow]
  rw [Nat.mod_eq_of_lt rep.1]

/-- An exact eight-byte Sail store establishes the corresponding little-endian integer
representation. -/
theorem uintRep_afterWriteBytes_eight (state : BinaryFv.RiscV.State)
    (address value : Nat)
    (valueFits : value < 2 ^ 64) (addressFits : address + 8 ≤ 2 ^ 64) :
    UIntRep 8
      (BinaryFv.RiscV.afterWriteBytes (width := 8) state address
        (BitVec.ofNat 64 value)).mem address value := by
  refine ⟨valueFits, addressFits, ?_⟩
  intro index indexBound
  have cases : index = 0 ∨ index = 1 ∨ index = 2 ∨ index = 3 ∨ index = 4 ∨ index = 5 ∨
      index = 6 ∨ index = 7 := by omega
  rcases cases with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl <;>
    simp [BinaryFv.RiscV.afterWriteBytes, BinaryFv.RiscV.afterByteWrites, byteAt,
      Std.ExtHashMap.get?_eq_getElem?, Std.ExtHashMap.getElem_insert]
  all_goals apply BitVec.eq_of_toNat_eq
  all_goals simp only [byteAt, BitVec.extractLsb'_toNat, BitVec.toNat_ofNat,
    Nat.shiftRight_eq_div_pow, Nat.mod_eq_of_lt valueFits]
  all_goals simp [show 2 ^ 8 = 256 by decide, show 2 ^ 16 = 65536 by decide,
    show 2 ^ 24 = 16777216 by decide, show 2 ^ 32 = 4294967296 by decide,
    show 2 ^ 40 = 1099511627776 by decide, show 2 ^ 48 = 281474976710656 by decide,
    show 2 ^ 56 = 72057594037927936 by decide]

def BytesRep (mem : Std.ExtHashMap Nat (BitVec 8)) (address : Nat)
    (bytes : Array UInt8) : Prop :=
  address + bytes.size ≤ 2 ^ 64 ∧
    ∀ index (inBounds : index < bytes.size),
      mem.get? (address + index) = some (BitVec.ofNat 8 bytes[index].toNat)

/-- Every byte in a fixed machine-memory window is initialized. The existential byte array records
the concrete padding bytes without assigning them source-level meaning. -/
def InitializedByteWindow (mem : Std.ExtHashMap Nat (BitVec 8)) (address width : Nat) : Prop :=
  ∃ bytes : Array UInt8, bytes.size = width ∧ BytesRep mem address bytes

/-- Consecutive initialized machine words, used for optimized struct slots that Zig reads even when
their source-level optional payload is absent. -/
def DwordWindowRep (mem : Std.ExtHashMap Nat (BitVec 8)) (address count : Nat) : Prop :=
  ∃ values : Fin count → Nat,
    ∀ index (inBounds : index < count), UIntRep 8 mem (address + index * 8)
      (values ⟨index, inBounds⟩)

def ArrayRep (stride : Nat) (elementRep : Std.ExtHashMap Nat (BitVec 8) → Nat → α → Prop)
    (mem : Std.ExtHashMap Nat (BitVec 8)) (address : Nat) (values : Array α) : Prop :=
  address + values.size * stride ≤ 2 ^ 64 ∧
    ∀ index (inBounds : index < values.size),
      elementRep mem (address + index * stride) values[index]

def SliceRep (stride : Nat) (elementRep : Std.ExtHashMap Nat (BitVec 8) → Nat → α → Prop)
    (mem : Std.ExtHashMap Nat (BitVec 8)) (descriptor : Nat) (values : Array α) : Prop :=
  ∃ data : Nat,
    UIntRep 8 mem descriptor data ∧
    UIntRep 8 mem (descriptor + 8) values.size ∧
    ArrayRep stride elementRep mem data values

def ByteSliceRep (mem : Std.ExtHashMap Nat (BitVec 8)) (descriptor : Nat)
    (bytes : Array UInt8) : Prop :=
  SliceRep 1 (fun mem address byte => UIntRep 1 mem address byte.toNat) mem descriptor bytes

def OptionalUIntRep (width : Nat) (mem : Std.ExtHashMap Nat (BitVec 8))
    (address : Nat) : Option Nat → Prop
  | none => UIntRep 1 mem (address + width) 0
  | some value => UIntRep width mem address value ∧ UIntRep 1 mem (address + width) 1

/-- Zig uses the null pointer niche for `?[]const u8`; the length word is ignored for `none`. -/
def OptionalByteSliceRep (mem : Std.ExtHashMap Nat (BitVec 8))
    (address : Nat) : Option (Array UInt8) → Prop
  | none => UIntRep 8 mem address 0
  | some bytes => ∃ data : Nat,
      data ≠ 0 ∧ UIntRep 8 mem address data ∧ UIntRep 8 mem (address + 8) bytes.size ∧
        ArrayRep 1 (fun mem address byte => UIntRep 1 mem address byte.toNat) mem data bytes

def OptionalAddressRep (mem : Std.ExtHashMap Nat (BitVec 8))
    (address : Nat) : Option (Array UInt8) → Prop
  | none => UIntRep 1 mem (address + 20) 0
  | some bytes => bytes.size = 20 ∧ BytesRep mem address bytes ∧ UIntRep 1 mem (address + 20) 1

def AccessListEntryRep (mem : Std.ExtHashMap Nat (BitVec 8)) (address : Nat)
    (entry : AccessListEntry) : Prop :=
  SliceRep 32 (fun mem address bytes => bytes.size = 32 ∧ BytesRep mem address bytes)
      mem address entry.storageKeys ∧
    entry.address.size = 20 ∧ BytesRep mem (address + 16) entry.address

def AuthorizationRep (mem : Std.ExtHashMap Nat (BitVec 8)) (address : Nat)
    (authorization : Authorization) : Prop :=
  UIntRep 32 mem address authorization.chainId ∧
  UIntRep 32 mem (address + 32) authorization.r ∧
  UIntRep 32 mem (address + 64) authorization.s ∧
  UIntRep 8 mem (address + 96) authorization.nonce ∧
  UIntRep 8 mem (address + 104) authorization.v ∧
  authorization.address.size = 20 ∧ BytesRep mem (address + 112) authorization.address

def TransactionRep (mem : Std.ExtHashMap Nat (BitVec 8)) (address : Nat)
    (transaction : Transaction) : Prop :=
  UIntRep 16 mem address transaction.gasPrice ∧
  OptionalUIntRep 16 mem (address + 16) transaction.gasPriorityFee ∧
  UIntRep 32 mem (address + 48) transaction.value ∧
  UIntRep 16 mem (address + 80) transaction.maxFeePerBlobGas ∧
  UIntRep 32 mem (address + 96) transaction.r ∧
  UIntRep 32 mem (address + 128) transaction.s ∧
  OptionalUIntRep 8 mem (address + 160) transaction.chainId ∧
  UIntRep 8 mem (address + 176) transaction.nonce ∧
  UIntRep 8 mem (address + 184) transaction.gasLimit ∧
  ByteSliceRep mem (address + 192) transaction.data ∧
  SliceRep 40 AccessListEntryRep mem (address + 208) transaction.accessList ∧
  SliceRep 32 (fun mem address bytes => bytes.size = 32 ∧ BytesRep mem address bytes)
    mem (address + 224) transaction.blobHashes ∧
  SliceRep 144 AuthorizationRep mem (address + 240) transaction.authorizations ∧
  UIntRep 8 mem (address + 256) transaction.v ∧
  UIntRep 1 mem (address + 264) transaction.txType ∧
  OptionalAddressRep mem (address + 265) transaction.recipient

def WithdrawalRep (mem : Std.ExtHashMap Nat (BitVec 8)) (address : Nat)
    (withdrawal : Withdrawal) : Prop :=
  UIntRep 8 mem address withdrawal.index ∧
  UIntRep 8 mem (address + 8) withdrawal.validatorIndex ∧
  UIntRep 8 mem (address + 16) withdrawal.amount ∧
  withdrawal.address.size = 20 ∧ BytesRep mem (address + 24) withdrawal.address

def ExecutionPayloadRep (mem : Std.ExtHashMap Nat (BitVec 8)) (address : Nat)
    (payload : ExecutionPayload) : Prop :=
  UIntRep 8 mem address payload.blockNumber ∧
  UIntRep 8 mem (address + 8) payload.gasLimit ∧
  UIntRep 8 mem (address + 16) payload.gasUsed ∧
  UIntRep 8 mem (address + 24) payload.timestamp ∧
  ByteSliceRep mem (address + 32) payload.extraData ∧
  UIntRep 8 mem (address + 48) payload.baseFeePerGas ∧
  SliceRep 288 TransactionRep mem (address + 56) payload.transactions ∧
  SliceRep 16 ByteSliceRep mem (address + 72) payload.rawTransactions ∧
  SliceRep 48 WithdrawalRep mem (address + 88) payload.withdrawals ∧
  UIntRep 8 mem (address + 104) payload.blobGasUsed ∧
  UIntRep 8 mem (address + 112) payload.excessBlobGas ∧
  OptionalUIntRep 8 mem (address + 120) payload.slotNumber ∧
  ByteSliceRep mem (address + 136) payload.blockAccessList ∧
  payload.parentHash.size = 32 ∧ BytesRep mem (address + 152) payload.parentHash ∧
  payload.feeRecipient.size = 20 ∧ BytesRep mem (address + 184) payload.feeRecipient ∧
  payload.stateRoot.size = 32 ∧ BytesRep mem (address + 204) payload.stateRoot ∧
  payload.receiptsRoot.size = 32 ∧ BytesRep mem (address + 236) payload.receiptsRoot ∧
  payload.logsBloom.size = 256 ∧ BytesRep mem (address + 268) payload.logsBloom ∧
  payload.prevRandao.size = 32 ∧ BytesRep mem (address + 524) payload.prevRandao ∧
  payload.blockHash.size = 32 ∧ BytesRep mem (address + 556) payload.blockHash

def ExecutionRequestsRep (mem : Std.ExtHashMap Nat (BitVec 8)) (address : Nat)
    (requests : ExecutionRequests) : Prop :=
  ByteSliceRep mem address requests.deposits ∧
  ByteSliceRep mem (address + 16) requests.withdrawals ∧
  ByteSliceRep mem (address + 32) requests.consolidations ∧
  ByteSliceRep mem (address + 48) requests.builderDeposits ∧
  ByteSliceRep mem (address + 64) requests.builderExits

def ChainConfigRep (mem : Std.ExtHashMap Nat (BitVec 8)) (address : Nat)
    (config : ChainConfig) : Prop :=
  UIntRep 8 mem address config.chainId ∧
  OptionalByteSliceRep mem (address + 8) config.forkName ∧
  UIntRep 8 mem (address + 24) config.activeForkIndex ∧
  OptionalUIntRep 8 mem (address + 32) config.activationBlock ∧
  OptionalUIntRep 8 mem (address + 48) config.activationTimestamp

/-- Exact 848-byte optimized Zig value plus every heap object reachable through its slices. -/
def StatelessInputRep (mem : Std.ExtHashMap Nat (BitVec 8)) (address : Nat)
    (decoded : ZesuDecodedResult) : Prop :=
  address + 848 ≤ 2 ^ 64 ∧
  ExecutionPayloadRep mem address decoded.payload ∧
  SliceRep 32 (fun mem address bytes => bytes.size = 32 ∧ BytesRep mem address bytes)
    mem (address + 592) decoded.versionedHashes ∧
  ExecutionRequestsRep mem (address + 608) decoded.executionRequests ∧
  decoded.parentBeaconBlockRoot.size = 32 ∧
    BytesRep mem (address + 688) decoded.parentBeaconBlockRoot ∧
  SliceRep 16 ByteSliceRep mem (address + 720) decoded.witnessNodes ∧
  SliceRep 16 ByteSliceRep mem (address + 736) decoded.witnessCodes ∧
  SliceRep 16 ByteSliceRep mem (address + 752) decoded.witnessHeaders ∧
  ChainConfigRep mem (address + 768) decoded.chainConfig ∧
  SliceRep 16 ByteSliceRep mem (address + 832) decoded.publicKeys

end BinaryFv.Zesu
