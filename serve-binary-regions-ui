#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
port="${1:-8420}"

cd "$repo_root"
nix build .#machine-regions-ui --out-link result-binary-regions-ui
exec python3 tools/serve_static_no_cache.py "$port" --bind 0.0.0.0 \
  --directory result-binary-regions-ui
